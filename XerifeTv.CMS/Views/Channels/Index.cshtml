@using XerifeTv.CMS.Modules.Channel.Dtos.Response
@using XerifeTv.CMS.Modules.Channel.Enums

@model IEnumerable<GetChannelResponseDto>;

@{
    ViewData["Title"] = "Canais";

    ICollection<string[]> filters = [];
    filters.Add([EChannelSearchFilter.TITLE.ToString().ToLower(), "Titulo"]);
    filters.Add([EChannelSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
}

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Canais</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Channels" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="row mb-3 justify-content-between align-items-center">
        <a class="d-none d-md-block col-1 fs-5" role="button" asp-controller="Channels" asp-action="Index">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <div class="col-md-8 col-lg-5">
            <form class="input-group input-group-sm"
                  asp-controller="Channels"
                  asp-action="Index"
                  method="get">

                @* <input type="hidden"
                       name="currentPage"
                       value="@(ViewBag.Filter is not null ? ViewBag.CurrentPage : 1)" /> *@

                <select class="form-select shadow-none" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>

                <input type="text"
                       name="search"
                       class="form-control shadow-none"
                       value="@ViewBag.Search"
                       required>
                <button class="btn btn-success shadow-none" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>

        <div class="col-auto">
            <div class="view-toggle btn-group" data-view-key="channels" role="group" aria-label="Alternar visualização">
                <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="grid" title="Visualização em grade">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="list" title="Visualização em lista">
                    <i class="fa-solid fa-list"></i>
                </button>
            </div>
        </div>
    </div>


    @await Html.PartialAsync("_VideoModal")

    <div class="content-view" data-view-key="channels">
    <div class="view-grid row gap-3">
        @foreach (var channel in Model)
        {
            <div class="card col-md-4 col-xl-2 pt-1 overflow-hidden">
                <div class="w-auto position-relative bg-body-tertiary" style="height: 9rem;">
                    <img src="@channel.LogoUrl"
                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                         class="w-100 h-100 object-fit-cover"
                         alt="@channel.Title"
                         loading="lazy" />

                    <div class="position-absolute bottom-0 start-0 end-0 px-2 pt-4 pb-2"
                         style="background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 55%, transparent 100%);">
                        <h5 class="text-white text-nowrap overflow-hidden text-truncate mb-0" style="font-size: 0.9rem;">@channel.Title</h5>
                        <span class="text-white-50" style="font-size: 0.72rem;">@channel.Categories.Split(",").Select(x => x.Trim()).FirstOrDefault()</span>
                    </div>

                    @if (channel.Disabled)
                    {
                        <span class="position-absolute text-danger"
                              style="top: 6px; left: 8px; font-size: 24px;">
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </span>
                    }

                </div>

                <div class="card-body d-flex align-items-center justify-content-end gap-1 py-2 px-2">
                    @if (!User.IsInRole("visitor"))
                    {
                        <a class="btn btn-sm btn-primary"
                           asp-controller="Channels"
                           asp-action="Form"
                           asp-route-id="@channel.Id"
                           title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    }

                    <a class="btn btn-sm btn-secondary"
                       data-bs-toggle="modal"
                       data-bs-target="#videoModal"
                       data-bs-title="@channel.Title"
                       data-bs-banner="@channel.LogoUrl"
                       data-bs-video-resolver="@channel?.UrlResolverPath"
                       title="Assistir">
                        <i class="fa-solid fa-play"></i>
                    </a>
                </div>
            </div>
        }

        @if (Model?.Count() <= 0)
        {
            <div class="w-100 text-center text-secondary py-5">
                <i class="fa-solid fa-satellite-dish fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhum canal encontrado.</p>
            </div>
        }
    </div>

    <div class="view-list d-none">
        @if (Model?.Count() <= 0)
        {
            <div class="w-100 text-center text-secondary py-5">
                <i class="fa-solid fa-satellite-dish fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhum canal encontrado.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle content-list-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Categoria</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var channel in Model)
                        {
                            <tr>
                                <td style="width: 3.5rem;">
                                    <img src="@channel.LogoUrl"
                                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                         class="content-list-thumb"
                                         alt="@channel.Title" />
                                </td>
                                <td class="fw-semibold">@channel.Title</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill">
                                        @channel.Categories.Split(",").Select(x => x.Trim()).FirstOrDefault()
                                    </span>
                                </td>
                                <td>
                                    @if (channel.Disabled)
                                    {
                                        <span class="badge rounded-pill bg-danger">Desativado</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success">Ativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (!User.IsInRole("visitor"))
                                        {
                                            <a class="btn btn-sm btn-primary" asp-controller="Channels" asp-action="Form" asp-route-id="@channel.Id" title="Editar">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        }

                                        <a class="btn btn-sm btn-secondary"
                                           data-bs-toggle="modal"
                                           data-bs-target="#videoModal"
                                           data-bs-title="@channel.Title"
                                           data-bs-banner="@channel.LogoUrl"
                                           data-bs-video-resolver="@channel?.UrlResolverPath"
                                           title="Assistir">
                                            <i class="fa-solid fa-play"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>