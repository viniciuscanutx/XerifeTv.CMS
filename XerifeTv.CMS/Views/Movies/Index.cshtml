@using XerifeTv.CMS.Modules.Movie.Dtos.Response
@using XerifeTv.CMS.Modules.Movie.Enums
@using XerifeTv.CMS.Extensions
@using XerifeTv.CMS.Modules.Abstractions.Interfaces
@inject ISystemSettingsService SystemSettingsService

@model IEnumerable<GetMovieResponseDto>;

@{
    ViewData["Title"] = "Filmes";

    ICollection<string[]> filters = [];
    filters.Add([EMovieSearchFilter.TITLE.ToString().ToLower(), "Titulo"]);
    filters.Add([EMovieSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
    filters.Add([EMovieSearchFilter.RELEASE_YEAR.ToString().ToLower(), "Ano de Lançamento"]);
    filters.Add([EMovieSearchFilter.PARENTAL_RATING.ToString().ToLower(), "Classificação Indicativa"]);
    filters.Add([EMovieSearchFilter.ONLY_DISABLED.ToString().ToLower(), "Somente Desativados"]);
    filters.Add([EMovieSearchFilter.FRANCHISE.ToString().ToLower(), "Franquia"]);
}

<div class="container">
    @if (SystemSettingsService.IsMoviesSpreadsheetImportEnabled())
    {
        @await Html.PartialAsync("_ImportFromExcelModal")
    }
    @await Html.PartialAsync("_BatchMoviesModal")

    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Filmes</span>

            @if (!User.IsInRole("visitor"))
            {
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-success shadow-none"
                            data-bs-toggle="modal"
                            data-bs-target="#batchMoviesModal">
                        <i class="fa-solid fa-link me-1"></i> Adicionar Vários Filmes
                    </button>

                    @if (SystemSettingsService.IsMoviesSpreadsheetImportEnabled())
                    {
                        <button class="btn btn-success shadow-none"
                                data-bs-toggle="modal"
                                data-bs-target="#importFromExcelModal">
                            <i class="fa-regular fa-file-excel me-1"></i> Importar Planilha
                        </button>
                    }

                    <a class="btn btn-primary" asp-controller="Movies" asp-action="Form">
                        <i class="fa-solid fa-plus"></i> Cadastrar
                    </a>
                </div>
            }
        </div>
        <hr />
    </header>

    <div class="content-toolbar">
        <a class="content-toolbar__icon-btn" asp-controller="Movies" asp-action="Index" title="Atualizar">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <form class="content-toolbar__search-group"
              asp-controller="Movies"
              asp-action="Index"
              method="get">

            <div class="content-toolbar__select-wrap">
                <select class="content-toolbar__select" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>
                <i class="fa-solid fa-chevron-down content-toolbar__select-caret"></i>
            </div>

            <div class="content-toolbar__search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       name="search"
                       placeholder="Buscar por título..."
                       value="@ViewBag.Search"
                       required>
            </div>

        </form>

        <div class="view-toggle btn-group ms-lg-auto" data-view-key="movies" role="group" aria-label="Alternar visualização">
            <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="grid" title="Visualização em grade">
                <i class="fa-solid fa-table-cells-large"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="list" title="Visualização em lista">
                <i class="fa-solid fa-list"></i>
            </button>
        </div>
    </div>


    @await Html.PartialAsync("_VideoModal")

    <div class="content-view" data-view-key="movies">
    <div class="view-grid poster-grid">
        @foreach (var movie in Model)
        {
            <article class="poster-card @((movie?.Disabled ?? false) ? "poster-card--disabled" : "")">
                <div class="poster-card__media">
                    <img src="@movie.PosterUrl"
                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                         alt="@movie.Title"
                         loading="lazy" />

                    <div class="poster-card__badges">
                        @if (movie?.HighQuality ?? false)
                        {
                            <span class="poster-card__badge poster-card__badge--4k">4K</span>
                        }

                        @if (!string.IsNullOrEmpty(@movie?.Video?.Subtitle))
                        {
                            <span class="poster-card__badge poster-card__badge--cc">CC</span>
                        }
                    </div>

                    @if (@movie?.Disabled ?? false)
                    {
                        <span class="poster-card__badge poster-card__badge--off" title="Desativado">
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </span>
                    }

                    <div class="poster-card__info">
                        <h3 class="poster-card__title">@movie?.Title</h3>
                        <span class="poster-card__meta">
                            @movie?.ReleaseYear
                            <span class="poster-card__dot">·</span>
                            @((movie?.Categories?
                                .Split(',')
                                .Select(x => x.Trim())
                                .FirstOrDefault() ?? string.Empty)
                                .CapitalizeFirstLetter())
                        </span>
                    </div>
                </div>

                <div class="poster-card__actions">
                    <a class="poster-card__action" data-bs-toggle="modal" data-bs-target="#movielDetailsModal-@movie?.Id" title="Ver detalhes">
                        <i class="fa-solid fa-eye"></i>
                    </a>

                    @if (!User.IsInRole("visitor"))
                    {
                        <a class="poster-card__action"
                           asp-controller="Movies"
                           asp-action="Form"
                           asp-route-id="@movie?.Id"
                           title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    }

                    <a class="poster-card__action poster-card__action--play"
                       data-bs-toggle="modal"
                       data-bs-target="#videoModal"
                       data-bs-title="@movie?.Title"
                       data-bs-banner="@movie?.BannerUrl"
                       data-bs-video-subtitle="@movie?.Video?.Subtitle"
                       data-bs-video-resolver="@movie?.UrlResolverPath"
                       data-bs-video-alternative-resolver="@movie?.AlternativeUrlResolverPath"
                       title="Assistir">
                        <i class="fa-solid fa-play"></i>
                    </a>
                </div>
            </article>

            @await Html.PartialAsync("_DetailsModal", movie)
        }

        @if (Model?.Count() <= 0)
        {
            <div class="poster-grid__empty text-center text-secondary py-5">
                <i class="fa-solid fa-film fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhum filme encontrado.</p>
            </div>
        }
    </div>

    <div class="view-list d-none">
        @if (Model?.Count() <= 0)
        {
            <div class="w-100 text-center text-secondary py-5">
                <i class="fa-solid fa-film fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhum filme encontrado.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle content-list-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Categoria</th>
                            <th>Ano</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td style="width: 3.5rem;">
                                    <img src="@movie.PosterUrl"
                                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                         class="content-list-thumb"
                                         alt="@movie.Title" />
                                </td>
                                <td class="fw-semibold">@movie.Title</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill">
                                        @((movie?.Categories?.Split(',').Select(x => x.Trim()).FirstOrDefault() ?? string.Empty).CapitalizeFirstLetter())
                                    </span>
                                </td>
                                <td>@movie?.ReleaseYear</td>
                                <td>
                                    @if (movie?.Disabled ?? false)
                                    {
                                        <span class="badge rounded-pill bg-danger">Desativado</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success">Ativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#movielDetailsModal-@movie?.Id" title="Ver detalhes">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        @if (!User.IsInRole("visitor"))
                                        {
                                            <a class="btn btn-sm btn-primary" asp-controller="Movies" asp-action="Form" asp-route-id="@movie?.Id" title="Editar">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        }

                                        <a class="btn btn-sm btn-secondary"
                                           data-bs-toggle="modal"
                                           data-bs-target="#videoModal"
                                           data-bs-title="@movie?.Title"
                                           data-bs-banner="@movie?.BannerUrl"
                                           data-bs-video-subtitle="@movie?.Video?.Subtitle"
                                           data-bs-video-resolver="@movie?.UrlResolverPath"
                                           data-bs-video-alternative-resolver="@movie?.AlternativeUrlResolverPath"
                                           title="Assistir">
                                            <i class="fa-solid fa-play"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>