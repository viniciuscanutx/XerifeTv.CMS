@using XerifeTv.CMS.Modules.Movie.Dtos.Response
@using XerifeTv.CMS.Shared.Helpers
@using XerifeTv.CMS.Views.Movies.Models
@using XerifeTv.CMS.Views.Shared.Models
@using XerifeTv.CMS.Modules.Abstractions.Interfaces
@using XerifeTv.CMS.Modules.User.Enums
@inject ISystemSettingsService SystemSettingsService

@model MovieFormModelView

@{
    ViewData["Title"] = "Filmes";

    bool isMediaDeliveryProfileSelected = !string.IsNullOrWhiteSpace(Model?.MovieDto?.MediaDeliveryProfileId);
    bool isNameSearchDefault = SystemSettingsService.GetDefaultImdbSearchMode() == EImdbSearchMode.NAME;
}

@if (SystemSettingsService.IsMoviesSpreadsheetImportEnabled())
{
    @await Html.PartialAsync("_ImportFromExcelModal")
}
@await Html.PartialAsync("_BatchMoviesModal")

<div class="container">
    <header>
        <div class="d-flex justify-content-between">
            <div class="d-flex align-items-center gap-4">
                <a asp-controller="Movies" asp-action="Index" class="fs-4">
                    <i class="fa fa-undo" aria-hidden="true"></i>
                </a>
                <span class="fs-3 fw-normal">
                    @(Model?.MovieDto is GetMovieResponseDto ? "Editar" : "Cadastrar") Filme
                </span>
            </div>

            @if (Model?.MovieDto is null)
            {
                <div class="d-none d-lg-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-success d-flex justify-content-center align-items-center gap-2 shadow-none"
                            data-bs-toggle="modal"
                            data-bs-target="#batchMoviesModal">
                        <i class="fa-solid fa-link"></i> Adicionar Vários Filmes
                    </button>

                    @if (SystemSettingsService.IsMoviesSpreadsheetImportEnabled())
                    {
                        <button class="btn btn-sm btn-success d-flex justify-content-center align-items-center gap-2 shadow-none"
                                data-bs-toggle="modal"
                                data-bs-target="#importFromExcelModal">
                            <i class="fa-regular fa-file-excel"></i> Importar Planilha
                        </button>
                    }
                </div>
            }
        </div>
        <hr />
    </header>

    <main>
        <form asp-controller="Movies" asp-action="@(Model?.MovieDto is null ? "Create" : "Update")">
            <input type="hidden" name="id" value="@Model?.MovieDto?.Id">

            <div class="row mb-3">
                <div class="col-12 col-md-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">Buscar por</label>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button"
                                    class="btn search-mode-btn @(isNameSearchDefault ? "btn-outline-secondary" : "btn-secondary active")"
                                    data-mode="imdb">
                                IMDB ID
                            </button>
                            <button type="button"
                                    class="btn search-mode-btn @(isNameSearchDefault ? "btn-secondary active" : "btn-outline-secondary")"
                                    data-mode="name">
                                Nome
                            </button>
                        </div>
                    </div>

                    <div class="search-mode-panel @(isNameSearchDefault ? "d-none" : "")" data-mode-panel="imdb">
                        <div class="input-group">
                            <input type="text"
                                   name="imdbId"
                                   id="imdbId"
                                   class="form-control"
                                   placeholder="tt999999"
                                   value="@Model?.MovieDto?.ImdbId"
                            @(isNameSearchDefault ? "" : "required")>

                            <button id="btn-get-imdb"
                                    class="btn btn-success shadow-none"
                                    type="button">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </div>
                    </div>

                    <div class="search-mode-panel position-relative @(isNameSearchDefault ? "" : "d-none")" data-mode-panel="name">
                        <input type="text"
                               id="titleSearch"
                               class="form-control"
                               placeholder="Pesquise pelo nome..."
                               autocomplete="off"
                               role="combobox"
                               aria-expanded="false"
                               aria-autocomplete="list"
                               aria-controls="titleSearchResults">
                        <div id="titleSearchResults"
                             class="list-group position-absolute w-100 shadow-sm"
                             style="z-index: 1050; max-height: 320px; overflow-y: auto;"
                             role="listbox"
                             hidden></div>
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <label for="title" class="form-label">Titulo</label>
                    <input type="text"
                           class="form-control"
                           id="title"
                           name="title"
                           placeholder="Digite aqui..."
                           value="@Model?.MovieDto?.Title"
                           required>
                </div>

                <div class="col-12 col-md-4">
                    <label for="categories" class="form-label">Categorias</label>

                    <div class="input-group-tags">
                        <input type="text"
                               id="categories"
                               class="form-control input-tags"
                               placeholder="ação, aventura, comédia..."
                               value="@Model?.MovieDto?.Categories">

                        <input type="hidden"
                               name="categories"
                               class="input-tags-value"
                               data-required-message="Informe no minino uma categoria"
                               required>

                        <div class="w-100 container-tags d-flex flex-wrap gap-1 mt-2"></div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label for="synopsis" class="form-label">Sinopse</label>
                <textarea id="synopsis"
                          name="synopsis"
                          class="form-control"
                          placeholder="Digite aqui..."
                          style="height: 100px"
                          required>@Model?.MovieDto?.Synopsis</textarea>
            </div>

            <div class="row mb-3">
                <div class="col-12 col-md-4">
                    <label for="releaseYear" class="form-label">Ano de Lançamento</label>
                    <input type="text"
                           class="form-control"
                           id="releaseYear"
                           name="releaseYear"
                           placeholder="2020"
                           value="@Model?.MovieDto?.ReleaseYear"
                           required>
                </div>

                <div class="col-sm-3 col-lg-5 px-4">
                    <label class="form-label">Classificação Indicativa</label>
                    <div class="d-flex flex-wrap">
                        @foreach (var year in ParentalRatingHelper.ParentalRatingList)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       name="parentalRating"
                                       id="parentalRating-@year"
                                       value="@year"
                                @(Model?.MovieDto?.ParentalRating == year ? "checked" : "")
                                       required>

                                <label class="form-check-label" for="parentalRating-@year">
                                    @(year == 0 ? "L" : year)
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <label for="review" class="form-label">Review</label>
                    <input type="text"
                           class="form-control"
                           id="review"
                           name="review"
                           placeholder="7,9"
                           value="@Model?.MovieDto?.Review"
                           required>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label for="posterUrl" class="form-label">Poster (URL)</label>
                    <input type="text"
                           class="form-control"
                           id="posterUrl"
                           name="posterUrl"
                           placeholder="http://imagem.com/image.jpg"
                           value="@Model?.MovieDto?.PosterUrl"
                           required>
                </div>

                <div class="col-6">
                    <label for="bannerUrl" class="form-label">Banner (URL)</label>
                    <input type="text"
                           class="form-control"
                           id="bannerUrl"
                           name="bannerUrl"
                           placeholder="http://imagem.com/image.jpg"
                           value="@Model?.MovieDto?.BannerUrl"
                           required>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <label for="logoUrl" class="form-label">Logo (URL)</label>
                    <input type="text"
                           class="form-control"
                           id="logoUrl"
                           name="logoUrl"
                           placeholder="Preenchido automaticamente ao importar do TMDB"
                           value="@Model?.MovieDto?.LogoUrl">
                </div>
            </div>

            @await Html.PartialAsync("_FranchiseField", new FranchiseFieldViewModel(
                "movie",
                Model?.MovieDto?.FranchiseId,
                Model?.SelectedFranchiseName,
                Model?.Franchises ?? []))

            <div class="row mb-4">
                <div class="col-6">
                    <label for="videoDuration" class="form-label">Duração(segundos)</label>
                    <input type="text"
                           class="form-control"
                           id="videoDuration"
                           name="videoDuration"
                           placeholder="3600"
                           value="@Model?.MovieDto?.Video?.Duration"
                           required>
                </div>

                <div class="col-6">
                    <label for="movie_videoSourceType" class="form-label">Fonte do vídeo</label>
                    <select id="movie_videoSourceType"
                            name="videoSourceType"
                            class="form-select">
                        @if (isMediaDeliveryProfileSelected)
                        {
                            <option value="direct">URL fixa</option>
                            <option value="delivery" selected>Perfil de entrega de mídia</option>
                        }
                        else
                        {
                            <option value="direct" selected>URL fixa</option>
                            <option value="delivery">Perfil de entrega de mídia</option>
                        }
                    </select>
                </div>
            </div>

            @await Html.PartialAsync("_VideoSetting", new VideoSettingViewModel
            {
                IdPrefix = "movie",
                VideoUrl = Model?.MovieDto?.Video?.Url,
                AlternativeVideoUrl = Model?.MovieDto?.AlternativeVideoUrl,
                VideoStreamFormat = Model?.MovieDto?.Video?.StreamFormat,
                VideoSubtitle = Model?.MovieDto?.Video?.Subtitle,
                MediaDeliveryProfileId = Model?.MovieDto?.MediaDeliveryProfileId,
                MediaRoute = Model?.MovieDto?.MediaRoute,
                FollowRedirect = Model?.MovieDto?.Video?.FollowRedirect ?? false,
                MediaDeliveryProfiles = Model?.MediaDeliveryProfiles ?? [],
                StreamFormats = StreamFormatsHelper.Vod
            })

            <div class="row mb-4">
                <div class="col-12">
                    <label for="trailerVideoYoutubeId" class="form-label">Trailer (YouTube Video ID)</label>
                    <input type="text"
                           class="form-control"
                           id="trailerVideoYoutubeId"
                           name="trailerVideoYoutubeId"
                           placeholder="Cole o link ou o ID do vídeo..."
                           value="@Model?.MovieDto?.TrailerVideoYoutubeId">
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-6">
                    <div class="form-check">
                        <input id="highQuality"
                               name="highQuality"
                               class="form-check-input"
                               type="checkbox"
                               value="@(Model?.MovieDto?.HighQuality == true ? "true" : "false")"
                        @(Model?.MovieDto?.HighQuality == true ? "checked" : "")>
                        <label class="form-check-label" for="highQuality">
                            Conteúdo em 4K (Alta Qualidade)
                        </label>
                    </div>
                </div>

                @if (Model?.MovieDto is GetMovieResponseDto movie)
                {
                    <div class="col-6">
                        <div class="form-check">
                            <input id="disabled"
                                   name="disabled"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="@(movie.Disabled ? "true" : "false")"
                            @(movie.Disabled ? "checked" : "")>
                            <label class="form-check-label" for="disabled">
                                Desativar
                            </label>
                        </div>
                    </div>
                }
            </div>

            <hr />
            <div class="d-flex align-items-center justify-content-between">
                <button type="submit" class="btn btn-primary mt-2">
                    @(Model?.MovieDto is GetMovieResponseDto ? "Editar" : "Cadastrar")
                </button>

                @if (Model?.MovieDto is GetMovieResponseDto)
                {
                    <button type="button" class="btn btn-danger" onclick="deleteMovie()">
                        <i class="fa fa-trash" aria-hidden="true"></i> Remover
                    </button>
                }
            </div>
        </form>
    </main>
</div>

@section scripts {
    <script>
        async function getMovieByTmdb(imdbId) {
          const response = await fetch(`/Movies/GetByImdbId?imdbId=${imdbId}`);
          return await response.json();
        }

        $('#btn-get-imdb').click(async (e) => {
          e.preventDefault();

          try {
            $('.loading-global .label').text('Importando os dados, por favor aguarde...');
            $('.loading-global').show();

            const imdbId = $('#imdbId').val();
            if (!imdbId) return;

            const response = await getMovieByTmdb(imdbId);
            if (!response) return;

            $('#title').val(response.title);
            $('#categories').val(response.genres.map(g => g.name.toLowerCase()).join(', '));
            $('#categories').blur();

            $('#synopsis').val(response.overview);
            $('#releaseYear').val(response.releaseYear);
            $('#review').val(String(response.voteAverage).replace(',', '.'));
            $('#posterUrl').val(response.posterUrl);
            $('#bannerUrl').val(response.bannerUrl);
            $('#logoUrl').val(response.logoUrl || '');
            $('#videoDuration').val(response.durationInSeconds);
          }
          finally {
            $('.loading-global').hide();
          }
        });

        $('.search-mode-btn').click(function () {
          const mode = $(this).data('mode');
          $('.search-mode-btn').removeClass('active btn-secondary').addClass('btn-outline-secondary');
          $(this).addClass('active btn-secondary').removeClass('btn-outline-secondary');
          $('.search-mode-panel').addClass('d-none');
          $(`.search-mode-panel[data-mode-panel="${mode}"]`).removeClass('d-none');

          // A required field that's hidden via display:none still silently blocks native
          // form submission in most browsers (no visible tooltip, submit event never fires) —
          // toggle `required` off while hidden so our own JS guard below can actually run.
          if (mode === 'name') {
            $('#imdbId').removeAttr('required');
          } else {
            $('#imdbId').attr('required', 'required');
          }
        });

        $('form').on('submit', function (e) {
          const activeMode = $('.search-mode-btn.active').data('mode');
          if (activeMode === 'name' && !$('#imdbId').val()) {
            e.preventDefault();
            alert('Selecione um resultado da busca por nome antes de salvar.');
          }
        });

        (function () {
          const minSearchLength = 2;
          const searchDebounceInMs = 250;
          let searchTimeoutId = null;
          let latestSearchRequest = 0;
          let currentResults = [];
          let activeIndex = -1;

          const titleSearchInput = document.getElementById('titleSearch');
          const titleSearchResults = document.getElementById('titleSearchResults');

          function optionId(index) {
            return `titleSearchResult-${index}`;
          }

          function closeResults() {
            titleSearchResults.hidden = true;
            titleSearchResults.innerHTML = '';
            titleSearchInput.setAttribute('aria-expanded', 'false');
            titleSearchInput.removeAttribute('aria-activedescendant');
            currentResults = [];
            activeIndex = -1;
          }

          function highlight(index) {
            const options = titleSearchResults.querySelectorAll('[role="option"]');
            options.forEach(option => option.classList.remove('active'));

            if (index < 0 || index >= options.length) {
              activeIndex = -1;
              titleSearchInput.removeAttribute('aria-activedescendant');
              return;
            }

            activeIndex = index;
            options[index].classList.add('active');
            options[index].scrollIntoView({ block: 'nearest' });
            titleSearchInput.setAttribute('aria-activedescendant', optionId(index));
          }

          function renderResults(results) {
            currentResults = results || [];
            activeIndex = -1;

            if (currentResults.length === 0) {
              closeResults();
              return;
            }

            titleSearchResults.innerHTML = currentResults.map((result, index) => `
              <button type="button"
                      class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                      role="option"
                      id="${optionId(index)}"
                      data-index="${index}">
                <img src="${result.posterUrl || ''}"
                     alt=""
                     style="width: 40px; height: 60px; object-fit: cover; flex-shrink: 0;"
                     onerror="this.style.visibility='hidden'">
                <span>${result.title}${result.releaseYear ? ' (' + result.releaseYear + ')' : ''}</span>
              </button>
            `).join('');

            titleSearchResults.hidden = false;
            titleSearchInput.setAttribute('aria-expanded', 'true');

            titleSearchResults.querySelectorAll('[role="option"]').forEach(option => {
              option.addEventListener('mousedown', function (e) {
                e.preventDefault();
                selectResult(currentResults[Number(this.dataset.index)]);
              });
            });
          }

          async function loadResults(term) {
            const normalizedTerm = (term || '').trim();
            if (normalizedTerm.length < minSearchLength) {
              closeResults();
              return;
            }

            const requestId = ++latestSearchRequest;

            try {
              const results = await $.ajax({
                url: '/Movies/SearchByName',
                method: 'GET',
                data: { term: normalizedTerm }
              });

              if (requestId !== latestSearchRequest) return;

              renderResults(results);
            }
            catch {
            }
          }

          async function selectResult(result) {
            if (!result) return;

            titleSearchInput.value = `${result.title}${result.releaseYear ? ' (' + result.releaseYear + ')' : ''}`;
            closeResults();

            try {
              $('.loading-global .label').text('Importando os dados, por favor aguarde...');
              $('.loading-global').show();

              const response = await $.ajax({
                url: '/Movies/GetByTmdbId',
                method: 'GET',
                data: { tmdbId: result.id }
              });

              if (!response) return;

              $('#imdbId').val(response.imdbId);
              $('#title').val(response.title);
              $('#categories').val(response.genres.map(g => g.name.toLowerCase()).join(', '));
              $('#categories').blur();

              $('#synopsis').val(response.overview);
              $('#releaseYear').val(response.releaseYear);
              $('#review').val(String(response.voteAverage).replace(',', '.'));
              $('#posterUrl').val(response.posterUrl);
              $('#bannerUrl').val(response.bannerUrl);
              $('#logoUrl').val(response.logoUrl || '');
              $('#videoDuration').val(response.durationInSeconds);
            }
            finally {
              $('.loading-global').hide();
            }
          }

          titleSearchInput?.addEventListener('input', function () {
            const term = this.value;

            if (searchTimeoutId) {
              window.clearTimeout(searchTimeoutId);
            }

            searchTimeoutId = window.setTimeout(function () {
              loadResults(term);
            }, searchDebounceInMs);
          });

          titleSearchInput?.addEventListener('keydown', function (e) {
            if (titleSearchResults.hidden) return;

            if (e.key === 'ArrowDown') {
              e.preventDefault();
              highlight(Math.min(activeIndex + 1, currentResults.length - 1));
            }
            else if (e.key === 'ArrowUp') {
              e.preventDefault();
              highlight(Math.max(activeIndex - 1, 0));
            }
            else if (e.key === 'Enter') {
              if (activeIndex >= 0) {
                e.preventDefault();
                selectResult(currentResults[activeIndex]);
              }
            }
            else if (e.key === 'Escape') {
              closeResults();
            }
          });

          titleSearchInput?.addEventListener('blur', function () {
            window.setTimeout(closeResults, 150);
          });

          document.addEventListener('click', function (e) {
            if (!titleSearchInput.contains(e.target) && !titleSearchResults.contains(e.target)) {
              closeResults();
            }
          });
        })();

        $('#trailerVideoYoutubeId').blur(function() {
            const url = $(this).val();
            const youtubeId = extractYouTubeVideoId(url);
            $(this).val(youtubeId);
        });

        $('#disabled').change(e => e.target.value = e.target.checked);
        $('#highQuality').change(e => e.target.value = e.target.checked);

        $('#videoDuration').keyup(e =>
          $('#videoDuration').val(convertHHmmToSeconds(e.target.value)));

        function deleteMovie() {
          if (!confirm('Deseja realmente remover o filme?')) return;
          location.href = '/Movies/Delete/@Model?.MovieDto?.Id';
        }

        function extractYouTubeVideoId(input) {
          const trimmedInput = input.trim();

          if (trimmedInput.length === 11 && !trimmedInput.includes('/') && !trimmedInput.includes('.')) {
            return trimmedInput;
          }

          const regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
          const match = trimmedInput.match(regExp);

          return (match && match[2].length === 11) ? match[2] : null;
        }

    </script>

    <script>
        initVideoSetting('movie');
    </script>
}