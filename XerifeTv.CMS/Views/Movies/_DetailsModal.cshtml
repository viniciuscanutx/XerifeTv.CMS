@using XerifeTv.CMS.Modules.Movie.Dtos.Response
@using XerifeTv.CMS.Shared.Helpers

@model GetMovieResponseDto;

<div
  class="modal fade"
  id="movielDetailsModal-@Model.Id"
  tabindex="-1"
  aria-labelledby="movielDetailsModal-@Model.Id-Label"
  aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content details-modal-dark">
      <button type="button" class="btn-close btn-close-white details-modal-dark__close" data-bs-dismiss="modal" aria-label="Close"></button>

      <div class="d-flex flex-column flex-md-row">
        <div class="details-modal-dark__poster">
          <img src="@Model.PosterUrl" onerror="this.onerror=null; this.src='/assets/poster_default.jpg';" alt="@Model.Title" />

          <span class="badge details-modal-dark__rating" style="background: @ParentalRatingHelper.ParentalRatingColors[Model.ParentalRating] !important;">
            @(Model.ParentalRating == 0 ? "L" : Model.ParentalRating)
          </span>

          @if (!string.IsNullOrEmpty(Model.ImdbId))
          {
            <a href="https://www.imdb.com/title/@Model.ImdbId" target="_blank" rel="noopener" class="btn btn-outline-light btn-sm details-modal-dark__imdb">
              <i class="fa-brands fa-imdb me-1"></i> IMDb
            </a>
          }
        </div>

        <div class="details-modal-dark__body">
          @if (Model.HighQuality || !string.IsNullOrEmpty(Model.AlternativeVideoUrl))
          {
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
              @if (Model.HighQuality)
              {
                <span class="badge bg-warning text-dark rounded-pill">4K</span>
              }

              @if (!string.IsNullOrEmpty(Model.AlternativeVideoUrl))
              {
                <span class="badge bg-info rounded-pill">CC</span>
              }
            </div>
          }

          <h2 id="movielDetailsModal-@Model.Id-Label" class="fw-semibold">@Model.Title <span class="text-secondary">(@Model.ReleaseYear)</span> </h2>
          
          <span class="text-warning mb-3"><i class="fa-solid fa-star"></i> <span class="text-white">@Model.Review.ToString("0.0")</span></span>

          <div class="mb-3">
            @foreach (var category in Model.Categories.Split(",").Select(x => x.Trim()))
            {
              <span class="badge bg-primary rounded-pill me-1 mb-1">@category</span>
            }
          </div>

          <p class="details-modal-dark__synopsis flex-grow-1">@Model.Synopsis</p>

          <div class="details-modal-dark__actions mt-3">
            @if (!User.IsInRole("visitor"))
            {
              <button type="button"
                      class="btn btn-outline-light btn-sm"
                      data-bs-dismiss="modal"
                      data-bs-toggle="modal"
                      data-bs-target="#quickEditMovieModal-@Model.Id">
                <i class="fa-solid fa-pen-to-square me-1"></i> Editar
              </button>
            }

            <a class="btn btn-primary btn-sm"
               data-bs-dismiss="modal"
               data-bs-toggle="modal"
               data-bs-target="#videoModal"
               data-bs-title="@Model.Title"
               data-bs-banner="@Model.BannerUrl"
               data-bs-video-subtitle="@Model.Video?.Subtitle"
               data-bs-video-resolver="@Model.UrlResolverPath"
               data-bs-video-alternative-resolver="@Model.AlternativeUrlResolverPath">
              <i class="fa-solid fa-play me-1"></i> Assistir
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@if (!User.IsInRole("visitor"))
{
  <div class="modal fade"
       id="quickEditMovieModal-@Model.Id"
       tabindex="-1"
       aria-labelledby="quickEditMovieModal-@Model.Id-Label"
       aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content details-modal-dark" asp-controller="Movies" asp-action="QuickUpdateVideoUrl" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="modal-header border-bottom border-secondary">
          <h5 class="modal-title fs-5 fw-semibold" id="quickEditMovieModal-@Model.Id-Label">
            <i class="fa-solid fa-link me-2 text-primary"></i>Editar Link - @Model.Title
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <label for="videoUrl-@Model.Id" class="form-label fw-semibold">Link do Vídeo (Dublado / Principal)</label>
            <input type="text"
                   class="form-control"
                   id="videoUrl-@Model.Id"
                   name="videoUrl"
                   placeholder="https://servidor.com/filme.m3u8"
                   value="@Model.Video?.Url"
                   required />
            <small class="text-secondary mt-1 d-block">Cole aqui a URL direta do vídeo dublado.</small>
          </div>

          <div class="mb-3">
            <label for="alternativeVideoUrl-@Model.Id" class="form-label fw-semibold">Link Legendado (Opcional)</label>
            <input type="text"
                   class="form-control"
                   id="alternativeVideoUrl-@Model.Id"
                   name="alternativeVideoUrl"
                   placeholder="https://servidor.com/filme-legendado.m3u8"
                   value="@Model.AlternativeVideoUrl" />
          </div>
        </div>

        <div class="modal-footer border-top border-secondary">
          <a class="btn btn-sm btn-outline-secondary me-auto" asp-controller="Movies" asp-action="Form" asp-route-id="@Model.Id">
            <i class="fa-solid fa-gear me-1"></i> Edição Completa
          </a>
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Link
          </button>
        </div>
      </form>
    </div>
  </div>
}
