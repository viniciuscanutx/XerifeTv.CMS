@using XerifeTv.CMS.Modules.Activity.Dtos.Response

@model IEnumerable<GetActivityLogResponseDto>

@{
    ViewData["Title"] = "Atividades";
}

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Atividades</span>
        </div>
        <hr />
    </header>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Data/Hora</th>
                    <th>Usuário</th>
                    <th>Categoria</th>
                    <th>Ação</th>
                    <th>Descrição</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Nenhuma atividade registrada</td>
                    </tr>
                }
                else
                {
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@activity.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@activity.UserName</td>
                            <td>@activity.Category</td>
                            <td>@activity.Action</td>
                            <td>@activity.Description</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>
