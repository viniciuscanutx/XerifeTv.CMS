@using XerifeTv.CMS.Modules.Series.Dtos.Response
@using XerifeTv.CMS.Modules.Series.Enums
@using XerifeTv.CMS.Extensions

@model IEnumerable<GetSeriesResponseDto>;

@{
    ViewData["Title"] = "Séries";

    ICollection<string[]> filters = [];
    filters.Add([ESeriesSearchFilter.TITLE.ToString().ToLower(), "Titulo"]);
    filters.Add([ESeriesSearchFilter.CATEGORY.ToString().ToLower(), "Categoria"]);
    filters.Add([ESeriesSearchFilter.RELEASE_YEAR.ToString().ToLower(), "Ano de Lançamento"]);
    filters.Add([ESeriesSearchFilter.PARENTAL_RATING.ToString().ToLower(), "Classificação Indicativa"]);
    filters.Add([ESeriesSearchFilter.ONLY_DISABLED.ToString().ToLower(), "Somente Desativados"]);
    filters.Add([ESeriesSearchFilter.FRANCHISE.ToString().ToLower(), "Franquia"]);
}

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Séries</span>

            @if (!User.IsInRole("visitor"))
            {
                <a class="btn btn-primary" asp-controller="Series" asp-action="Form">
                    <i class="fa-solid fa-plus"></i> Cadastrar
                </a>
            }
        </div>
        <hr />
    </header>

    <div class="content-toolbar">
        <a class="content-toolbar__icon-btn" asp-controller="Series" asp-action="Index" title="Atualizar">
            <i class="fa-solid fa-rotate"></i>
        </a>

        <form class="content-toolbar__search-group"
              asp-controller="Series"
              asp-action="Index"
              method="get">

            <div class="content-toolbar__select-wrap">
                <select class="content-toolbar__select" name="filter">
                    @foreach (var filter in filters)
                    {
                        if (filter[0].Equals(ViewBag.Filter))
                        {
                            <option value="@filter[0]" selected>@filter[1]</option>
                        }
                        else
                        {
                            <option value="@filter[0]">@filter[1]</option>
                        }
                    }
                </select>
                <i class="fa-solid fa-chevron-down content-toolbar__select-caret"></i>
            </div>

            <div class="content-toolbar__search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       name="search"
                       placeholder="Buscar por título..."
                       value="@ViewBag.Search"
                       required>
            </div>

        </form>

        <div class="view-toggle btn-group ms-lg-auto" data-view-key="series" role="group" aria-label="Alternar visualização">
            <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="grid" title="Visualização em grade">
                <i class="fa-solid fa-table-cells-large"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary view-toggle-btn" data-view="list" title="Visualização em lista">
                <i class="fa-solid fa-list"></i>
            </button>
        </div>
    </div>

    <div class="content-view" data-view-key="series">
    <div class="view-grid poster-grid">
        @foreach (var serie in Model)
        {
            <article class="poster-card @((serie?.Disabled ?? false) ? "poster-card--disabled" : "")">
                <div class="poster-card__media">
                    <img src="@serie.PosterUrl"
                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                         alt="@serie.Title"
                         loading="lazy" />

                    <div class="poster-card__badges">
                        @if (serie?.HighQuality ?? false)
                        {
                            <span class="poster-card__badge poster-card__badge--4k">4K</span>
                        }
                    </div>

                    @if (@serie?.Disabled ?? false)
                    {
                        <span class="poster-card__badge poster-card__badge--off" title="Desativado">
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </span>
                    }

                    <div class="poster-card__info">
                        <h3 class="poster-card__title">@serie?.Title</h3>
                        <span class="poster-card__meta">
                            @serie?.ReleaseYear
                            <span class="poster-card__dot">·</span>
                            @((serie?.Categories?
                                .Split(',')
                                .Select(x => x.Trim())
                                .FirstOrDefault() ?? string.Empty)
                                .CapitalizeFirstLetter())
                        </span>
                    </div>
                </div>

                <div class="poster-card__actions">
                    <a class="poster-card__action" data-bs-toggle="modal" data-bs-target="#seriesDetailsModal-@serie?.Id" title="Ver detalhes">
                        <i class="fa-solid fa-eye"></i>
                    </a>

                    @if (!User.IsInRole("visitor"))
                    {
                        <a class="poster-card__action"
                           asp-controller="Series"
                           asp-action="Form"
                           asp-route-id="@serie?.Id"
                           title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    }

                    <a class="poster-card__action"
                       asp-controller="Series"
                       asp-action="Episodes"
                       asp-route-id="@serie?.Id"
                       title="Episódios">
                        <i class="fa-solid fa-list"></i>
                    </a>
                </div>
            </article>

            @await Html.PartialAsync("_DetailsModal", serie)
        }

        @if (Model?.Count() <= 0)
        {
            <div class="poster-grid__empty text-center text-secondary py-5">
                <i class="fa-solid fa-video fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhuma série encontrada.</p>
            </div>
        }
    </div>

    <div class="view-list d-none">
        @if (Model?.Count() <= 0)
        {
            <div class="w-100 text-center text-secondary py-5">
                <i class="fa-solid fa-video fa-2x mb-3 d-block opacity-50"></i>
                <p class="mb-0 fs-5">Nenhuma série encontrada.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle content-list-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Título</th>
                            <th>Categoria</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var serie in Model)
                        {
                            <tr>
                                <td style="width: 3.5rem;">
                                    <img src="@serie.PosterUrl"
                                         onerror="this.onerror=null; this.src='/assets/poster_default.jpg';"
                                         class="content-list-thumb"
                                         alt="@serie.Title" />
                                </td>
                                <td class="fw-semibold">@serie.Title</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill">
                                        @((serie?.Categories?.Split(',').Select(x => x.Trim()).FirstOrDefault() ?? string.Empty).CapitalizeFirstLetter())
                                    </span>
                                </td>
                                <td>
                                    @if (serie?.Disabled ?? false)
                                    {
                                        <span class="badge rounded-pill bg-danger">Desativado</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success">Ativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#seriesDetailsModal-@serie?.Id" title="Ver detalhes">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        @if (!User.IsInRole("visitor"))
                                        {
                                            <a class="btn btn-sm btn-primary" asp-controller="Series" asp-action="Form" asp-route-id="@serie?.Id" title="Editar">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        }

                                        <a class="btn btn-sm btn-info" asp-controller="Series" asp-action="Episodes" asp-route-id="@serie?.Id" title="Episódios">
                                            <i class="fa-solid fa-list"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    </div>

    @await Html.PartialAsync("_Pagination")
</div>
