@using XerifeTv.CMS.Modules.Series.Dtos.Response
@using XerifeTv.CMS.Shared.Helpers

@model GetSeriesResponseDto

<div
  class="modal fade"
  id="seriesDetailsModal-@Model.Id"
  tabindex="-1"
  aria-labelledby="seriesDetailsModal-@Model.Id-Label"
  aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content details-modal-dark">
      <button type="button" class="btn-close btn-close-white details-modal-dark__close" data-bs-dismiss="modal" aria-label="Close"></button>

      <div class="d-flex flex-column flex-md-row">
        <div class="details-modal-dark__poster">
          <img src="@Model.PosterUrl" onerror="this.onerror=null; this.src='/assets/poster_default.jpg';" alt="@Model.Title" />

          <span class="badge details-modal-dark__rating" style="background: @ParentalRatingHelper.ParentalRatingColors[Model.ParentalRating] !important;">
            @(Model.ParentalRating == 0 ? "L" : Model.ParentalRating)
          </span>

          @if (!string.IsNullOrEmpty(Model.ImdbId))
          {
            <a href="https://www.imdb.com/title/@Model.ImdbId" target="_blank" rel="noopener" class="btn btn-outline-light btn-sm details-modal-dark__imdb">
              <i class="fa-brands fa-imdb me-1"></i> IMDb
            </a>
          }
        </div>

        <div class="details-modal-dark__body">
          <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            

            @if (Model.HighQuality)
            {
              <span class="badge bg-warning text-dark rounded-pill">4K</span>
            }

            <span class="badge bg-secondary rounded-pill">@Model.NumberSeasons temporada@(Model.NumberSeasons == 1 ? "" : "s")</span>

          </div>

          <h2 id="seriesDetailsModal-@Model.Id-Label" class="fw-semibold mb-2">@Model.Title<span class="text-secondary"> (@Model.ReleaseYear)</span></h2>

          <span class="text-warning mb-3"><i class="fa-solid fa-star"></i> <span class="text-white">@Model.Review.ToString("0.0")</span></span>

          <div class="mb-3">
            @foreach (var category in Model.Categories.Split(",").Select(x => x.Trim()))
            {
              <span class="badge bg-primary rounded-pill me-1 mb-1">@category</span>
            }
          </div>

          <p class="details-modal-dark__synopsis flex-grow-1">@Model.Synopsis</p>

          <div class="details-modal-dark__actions mt-3">
            @if (!User.IsInRole("visitor"))
            {
              <a class="btn btn-outline-light btn-sm" asp-controller="Series" asp-action="Form" asp-route-id="@Model.Id">
                <i class="fa-solid fa-pen-to-square me-1"></i> Editar
              </a>
            }

            <a class="btn btn-primary btn-sm" asp-controller="Series" asp-action="Episodes" asp-route-id="@Model.Id">
              <i class="fa-solid fa-list me-1"></i> Episódios
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
