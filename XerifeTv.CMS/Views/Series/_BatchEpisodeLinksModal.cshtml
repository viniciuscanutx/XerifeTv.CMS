@using XerifeTv.CMS.Shared.Helpers
@using XerifeTv.CMS.Modules.LinkTemplate.Dtos.Response

@inject IConfiguration Configuration

@{
    var linkTemplates = ViewBag.LinkTemplates as IEnumerable<GetLinkTemplateResponseDto> ?? [];
    var serieImdbId = (ViewBag.SerieImdbId as string) ?? string.Empty;
    var streamCatalogBaseUrl = (Configuration["StreamCatalog:BaseUrl"] ?? string.Empty).TrimEnd('/');
    var catalogProviders = ViewBag.CatalogProviders as IEnumerable<XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response.GetCatalogProviderResponseDto>
                           ?? Enumerable.Empty<XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response.GetCatalogProviderResponseDto>();
    var hasCatalogBase = catalogProviders.Any() || !string.IsNullOrWhiteSpace(streamCatalogBaseUrl);
    // O imdb da série já está salvo - o gerador usa direto + o provedor escolhido.
    var canGenerateByImdb = !string.IsNullOrWhiteSpace(serieImdbId) && hasCatalogBase;
}

<div class="modal fade"
     id="batchEpisodeLinksModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="batchEpisodeLinksModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content"
              asp-controller="Series"
              asp-action="BatchAddEpisodeLinks">

            <input type="hidden" name="serieId" value="@ViewBag.SerieId" />

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="batchEpisodeLinksModalLabel">
                    Adicionar Vários Links de Episódios em Lote
                </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">Modo de Operação</label>
                        <div class="btn-group w-100" role="group" aria-label="Modo de Operação">
                            <input type="radio" class="btn-check" name="mode" id="batch_mode_add" value="add" checked autocomplete="off">
                            <label class="btn btn-outline-success fw-semibold" for="batch_mode_add">
                                <i class="fa-solid fa-plus me-1"></i> Adicionar / Atualizar Links
                            </label>

                            <input type="radio" class="btn-check" name="mode" id="batch_mode_remove" value="remove" autocomplete="off">
                            <label class="btn btn-outline-danger fw-semibold" for="batch_mode_remove">
                                <i class="fa-solid fa-trash-can me-1"></i> Limpar Links
                            </label>
                        </div>
                    </div>
                </div>

                <div id="removeOptionsContainer" class="card p-3 mb-3 border-danger bg-danger-subtle d-none">
                    <h6 class="fw-bold text-danger mb-2">
                        <i class="fa-solid fa-eraser me-1"></i> Selecione o que deseja limpar:
                    </h6>
                    <div class="d-flex flex-column gap-2 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="removeTargetDublado" name="removeTarget" value="dublado">
                            <label class="form-check-label fw-semibold text-danger-emphasis" for="removeTargetDublado">
                                Limpar apenas links dublados (Link Primário)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="removeTargetLegendado" name="removeTarget" value="legendado">
                            <label class="form-check-label fw-semibold text-danger-emphasis" for="removeTargetLegendado">
                                Limpar apenas links legendados (Segundo Link)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="removeTargetBoth" name="removeTarget" value="both" checked>
                            <label class="form-check-label fw-semibold text-danger-emphasis" for="removeTargetBoth">
                                Limpar ambos (dublado e legendado)
                            </label>
                        </div>
                    </div>
                    <div class="row g-2 mt-2 pt-2 border-top border-danger-subtle align-items-start">
                        <div class="col-6" id="remove_start_ep_slot">
                            <!-- Episódio Inicial will be moved here in remove mode -->
                        </div>
                        <div class="col-6">
                            <label for="removeEpisodesCount" class="form-label mb-1 fw-bold text-danger-emphasis" style="font-size: 13px;">Quantidade de Episódios a Limpar:</label>
                            <input type="number" id="removeEpisodesCount" name="removeEpisodesCount" class="form-control form-control-sm" value="1" min="1">
                        </div>
                    </div>
                </div>

                <div class="row mb-3" id="batch_main_row">
                    <div class="col-4" id="batch_season_col">
                        <label for="batch_season" class="form-label">Temporada</label>
                        <select class="form-select"
                                id="batch_season"
                                name="season"
                                required>
                            @for (var i = 1; i <= (ViewBag.NumberSeasons ?? 1); i++)
                            {
                                if (i == ViewBag.SeasonFilter)
                                {
                                    <option value="@i" selected>@i ª Temporada</option>
                                }
                                else
                                {
                                    <option value="@i">@i ª Temporada</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-4" id="batch_startEpisode_col">
                        <label for="batch_startEpisodeNumber" class="form-label" id="batch_startEpisode_label">Episódio Inicial</label>
                        <input type="number"
                               id="batch_startEpisodeNumber"
                               name="startEpisodeNumber"
                               class="form-control"
                               value="1"
                               min="1"
                               max="@(ViewBag.MaxEpisodeNumber ?? 1)"
                               required />
                        <small class="text-muted" style="font-size: 11px;" id="batch_startEpisode_small">Máx: @(ViewBag.MaxEpisodeNumber ?? 1)</small>
                    </div>

                    <div class="col-4" id="batch_format_container">
                        <label for="batch_videoStreamFormat" class="form-label">Formato da Mídia</label>
                        <select id="batch_videoStreamFormat"
                                name="videoStreamFormat"
                                class="form-select"
                                required>
                            @foreach (var format in StreamFormatsHelper.Vod)
                            {
                                <option value="@format">@format</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3" id="batch_checkboxes_container">
                    <div class="col-12 d-flex flex-column gap-2">
                        <div class="form-check">
                            <input name="onlyExistingEpisodes"
                                   id="batch_onlyExistingEpisodes"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="true"
                                   checked>
                            <label for="batch_onlyExistingEpisodes" class="form-check-label">
                                Limitar atualização aos episódios existentes (ignorar links excedentes)
                            </label>
                        </div>

                        <div class="form-check">
                            <input name="highQuality"
                                   id="batch_highQuality"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="true">
                            <label for="batch_highQuality" class="form-check-label">
                                Marcar episódios como 4K (Alta Qualidade)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3" id="batch_generator_container">
                    <div class="col-12">
                        <div class="card border-success-subtle bg-success-subtle p-3">
                            <h6 class="fw-bold text-success-emphasis mb-1">
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Gerador de Sequência (opcional)
                            </h6>
                            <p class="text-muted mb-3" style="font-size: 12px;">
                                Informe <strong>um</strong> link e a quantidade — os demais são calculados incrementando o número final e preenchidos abaixo automaticamente.
                            </p>

                            <div class="btn-group btn-group-sm w-100 mb-3" role="group" aria-label="Origem do modelo">
                                <input type="radio" class="btn-check" name="gen_source" id="gen_source_manual" value="manual" checked autocomplete="off">
                                <label class="btn btn-outline-success" for="gen_source_manual">Link avulso</label>

                                <input type="radio" class="btn-check" name="gen_source" id="gen_source_type" value="type" autocomplete="off" @(linkTemplates.Any() ? "" : "disabled")>
                                <label class="btn btn-outline-success" for="gen_source_type">
                                    Tipo de link salvo @(linkTemplates.Any() ? "" : "(nenhum cadastrado)")
                                </label>

                                <input type="radio" class="btn-check" name="gen_source" id="gen_source_imdb" value="imdb" autocomplete="off" @(canGenerateByImdb ? "" : "disabled")>
                                <label class="btn btn-outline-success" for="gen_source_imdb">
                                    Links por ID IMDB @(canGenerateByImdb ? "" : "(indisponível)")
                                </label>
                            </div>

                            <div id="gen_imdb_block" class="mb-2 d-none">
                                <label for="gen_imdb_provider" class="form-label mb-1" style="font-size: 13px;">Provedor do catálogo</label>
                                <select id="gen_imdb_provider" class="form-select form-select-sm">
                                    @if (!catalogProviders.Any() && !string.IsNullOrWhiteSpace(streamCatalogBaseUrl))
                                    {
                                        <option value="@streamCatalogBaseUrl" selected>Padrão</option>
                                    }
                                    @foreach (var p in catalogProviders)
                                    {
                                        if (p.IsDefault)
                                        {
                                            <option value="@p.BaseUrl" selected>@p.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@p.BaseUrl">@p.Name</option>
                                        }
                                    }
                                </select>
                                <small class="text-muted d-block mt-1" style="font-size: 11px;">
                                    Usa o IMDb da série (<code>@(string.IsNullOrWhiteSpace(serieImdbId) ? "—" : serieImdbId)</code>)
                                    + <strong>Temporada</strong> + <strong>Episódio Inicial</strong> + quantidade.
                                    Monta: <code>{provedor}/stream/series/&lt;imdb&gt;:&lt;temp&gt;:&lt;ep&gt;.json</code>
                                </small>
                            </div>

                            <div id="gen_manual_block" class="mb-2">
                                <label for="gen_manual_url" class="form-label mb-1" style="font-size: 13px;">Link modelo (cole um episódio qualquer)</label>
                                <input type="text" id="gen_manual_url" class="form-control form-control-sm" placeholder="http://sventank.com/series/11982237031/luciano/92395.mp4" autocomplete="off">
                            </div>

                            <div id="gen_type_block" class="mb-2 d-none">
                                <label for="gen_type_select" class="form-label mb-1" style="font-size: 13px;">Tipo de link</label>
                                <select id="gen_type_select" class="form-select form-select-sm">
                                    @foreach (var t in linkTemplates)
                                    {
                                        <option value="@t.Id" data-template="@t.UrlTemplate" data-padding="@t.Padding">@t.Name</option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-1" style="font-size: 11px;">Modelo: <code id="gen_type_preview"></code></small>
                            </div>

                            <div class="row g-2 align-items-end mt-1">
                                <div class="col-4" id="gen_start_id_col">
                                    <label for="gen_start_id" class="form-label mb-1" style="font-size: 13px;">ID inicial</label>
                                    <input type="text" id="gen_start_id" class="form-control form-control-sm" inputmode="numeric" placeholder="92395" autocomplete="off">
                                </div>
                                <div class="col-4">
                                    <label for="gen_count" class="form-label mb-1" style="font-size: 13px;">Quantidade</label>
                                    <input type="number" id="gen_count" class="form-control form-control-sm" min="1" value="@(ViewBag.MaxEpisodeNumber ?? 1)">
                                </div>
                                <div class="col-4">
                                    <label for="gen_target" class="form-label mb-1" style="font-size: 13px;">Aplicar em</label>
                                    <select id="gen_target" class="form-select form-select-sm">
                                        <option value="primary" selected>Links Primários</option>
                                        <option value="secondary">Segundo Link (Legendado)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
                                <small id="gen_feedback" style="font-size: 12px;"></small>
                                <button type="button" id="gen_btn" class="btn btn-sm btn-success flex-shrink-0">
                                    <i class="fa-solid fa-list-ol me-1"></i> Gerar e preencher
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3" id="batch_primary_links_container">
                    <div class="col-12">
                        <label for="videoUrlsText" class="form-label fw-bold">Links Primários (Opcional - Um link por linha)</label>
                        <textarea id="videoUrlsText"
                                  name="videoUrlsText"
                                  class="form-control"
                                  rows="6"
                                  placeholder="https://servidor.com/video-ep1.m3u8&#10;https://servidor.com/video-ep2.m3u8&#10;https://servidor.com/video-ep3.m3u8"></textarea>
                        <small id="batch_ep_info" class="text-muted">A linha 1 corresponderá ao Episódio 1, linha 2 ao Episódio 2, e assim por diante.</small>
                    </div>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const startEpInput = document.getElementById("batch_startEpisodeNumber");
                        const infoSmall = document.getElementById("batch_ep_info");
                        if (startEpInput && infoSmall) {
                            const maxEp = parseInt(startEpInput.getAttribute("max")) || 1;
                            const updateInfo = function () {
                                let val = parseInt(startEpInput.value) || 1;
                                const onlyExistingChecked = document.getElementById("batch_onlyExistingEpisodes")?.checked;
                                if (onlyExistingChecked && val > maxEp) {
                                    val = maxEp;
                                    startEpInput.value = maxEp;
                                }
                                if (val < 1) {
                                    val = 1;
                                    startEpInput.value = 1;
                                }
                                infoSmall.textContent = `A linha 1 corresponderá ao Episódio ${val}, linha 2 ao Episódio ${val + 1}, e assim por diante.`;
                            };
                            startEpInput.addEventListener("input", updateInfo);
                            startEpInput.addEventListener("change", updateInfo);
                        }
                    });
                </script>

                <div class="row mb-3" id="batch_secondary_links_container">
                    <div class="col-12">
                        <label for="alternativeVideoUrlsText" class="form-label fw-bold">Segundo Link / Legendado (Opcional - Um link por linha)</label>
                        <textarea id="alternativeVideoUrlsText"
                                  name="alternativeVideoUrlsText"
                                  class="form-control"
                                  rows="4"
                                  placeholder="https://servidor.com/video-ep1-legendado.m3u8&#10;https://servidor.com/video-ep2-legendado.m3u8"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input class="form-check-input shadow-sm" type="checkbox" id="isBackgroundJobBatchEpisodes" name="isBackgroundJob" value="true">
                    <label class="form-check-label" for="isBackgroundJobBatchEpisodes" style="font-weight: 500; font-size: 14px;">Processar em segundo plano</label>
                </div>

                <div>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" id="batch_submit_btn" class="btn btn-success">
                        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Processar Links em Lote
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modeAddRadio = document.getElementById("batch_mode_add");
        const modeRemoveRadio = document.getElementById("batch_mode_remove");
        const removeContainer = document.getElementById("removeOptionsContainer");
        const submitBtn = document.getElementById("batch_submit_btn");
        const modalTitle = document.getElementById("batchEpisodeLinksModalLabel");

        const formatContainer = document.getElementById("batch_format_container");
        const formatSelect = document.getElementById("batch_videoStreamFormat");
        const checkboxesContainer = document.getElementById("batch_checkboxes_container");
        const primaryLinksContainer = document.getElementById("batch_primary_links_container");
        const secondaryLinksContainer = document.getElementById("batch_secondary_links_container");
        const generatorContainer = document.getElementById("batch_generator_container");
        const seasonCol = document.getElementById("batch_season_col");
        const startEpCol = document.getElementById("batch_startEpisode_col");
        const startEpLabel = document.getElementById("batch_startEpisode_label");
        const startEpInput = document.getElementById("batch_startEpisodeNumber");
        const startEpSmall = document.getElementById("batch_startEpisode_small");
        const removeStartEpSlot = document.getElementById("remove_start_ep_slot");
        const mainRow = document.getElementById("batch_main_row");

        function updateModeUI() {
            if (modeRemoveRadio && modeRemoveRadio.checked) {
                if (removeContainer) removeContainer.classList.remove("d-none");
                if (formatContainer) formatContainer.classList.add("d-none");
                if (checkboxesContainer) checkboxesContainer.classList.add("d-none");
                if (generatorContainer) generatorContainer.classList.add("d-none");
                if (primaryLinksContainer) primaryLinksContainer.classList.add("d-none");
                if (secondaryLinksContainer) secondaryLinksContainer.classList.add("d-none");

                if (formatSelect) {
                    formatSelect.removeAttribute("required");
                    formatSelect.disabled = true;
                }

                // Move Episódio Inicial into removeOptionsContainer slot
                if (startEpCol && removeStartEpSlot) {
                    startEpCol.className = "col-12";
                    removeStartEpSlot.appendChild(startEpCol);
                }
                if (startEpLabel) {
                    startEpLabel.className = "form-label mb-1 fw-bold text-danger-emphasis";
                    startEpLabel.style.fontSize = "13px";
                    startEpLabel.textContent = "Episódio Inicial:";
                }
                if (startEpInput) {
                    startEpInput.className = "form-control form-control-sm";
                }
                if (startEpSmall) {
                    startEpSmall.classList.add("d-none");
                }

                if (seasonCol) seasonCol.className = "col-12";

                if (submitBtn) {
                    submitBtn.className = "btn btn-danger";
                    submitBtn.innerHTML = '<i class="fa-solid fa-trash-can me-1"></i> Limpar Links em Lote';
                }
                if (modalTitle) {
                    modalTitle.textContent = "Limpar Links de Episódios em Lote";
                }
            } else {
                if (removeContainer) removeContainer.classList.add("d-none");
                if (formatContainer) formatContainer.classList.remove("d-none");
                if (checkboxesContainer) checkboxesContainer.classList.remove("d-none");
                if (generatorContainer) generatorContainer.classList.remove("d-none");
                if (primaryLinksContainer) primaryLinksContainer.classList.remove("d-none");
                if (secondaryLinksContainer) secondaryLinksContainer.classList.remove("d-none");

                if (formatSelect) {
                    formatSelect.setAttribute("required", "required");
                    formatSelect.disabled = false;
                }

                // Move Episódio Inicial back into main row
                if (startEpCol && mainRow && formatContainer) {
                    startEpCol.className = "col-4";
                    mainRow.insertBefore(startEpCol, formatContainer);
                }
                if (startEpLabel) {
                    startEpLabel.className = "form-label";
                    startEpLabel.style.fontSize = "";
                    startEpLabel.textContent = "Episódio Inicial";
                }
                if (startEpInput) {
                    startEpInput.className = "form-control";
                }
                if (startEpSmall) {
                    startEpSmall.classList.remove("d-none");
                }

                if (seasonCol) seasonCol.className = "col-4";

                if (submitBtn) {
                    submitBtn.className = "btn btn-success";
                    submitBtn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up me-1"></i> Processar Links em Lote';
                }
                if (modalTitle) {
                    modalTitle.textContent = "Adicionar / Atualizar Vários Links de Episódios";
                }
            }
        }

        if (modeAddRadio) modeAddRadio.addEventListener("change", updateModeUI);
        if (modeRemoveRadio) modeRemoveRadio.addEventListener("change", updateModeUI);

        updateModeUI();

        const modalEl = document.getElementById("batchEpisodeLinksModal");
        if (modalEl) {
            modalEl.addEventListener("show.bs.modal", updateModeUI);
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sourceRadios = document.querySelectorAll('input[name="gen_source"]');
        const manualBlock = document.getElementById("gen_manual_block");
        const typeBlock = document.getElementById("gen_type_block");
        const manualUrl = document.getElementById("gen_manual_url");
        const typeSelect = document.getElementById("gen_type_select");
        const typePreview = document.getElementById("gen_type_preview");
        const startId = document.getElementById("gen_start_id");
        const startIdCol = document.getElementById("gen_start_id_col");
        const imdbBlock = document.getElementById("gen_imdb_block");
        const count = document.getElementById("gen_count");
        const target = document.getElementById("gen_target");
        const feedback = document.getElementById("gen_feedback");
        const genBtn = document.getElementById("gen_btn");

        // Injetados via Razor (Html.Raw + JSON evita o encoding que quebra strings em <script>)
        const SERIES_IMDB_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serieImdbId));
        const STREAM_CATALOG_BASE_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(streamCatalogBaseUrl));

        if (!genBtn) return;

        function normalizeImdbId(value) {
            const id = String(value || "").trim();
            return /^\d+$/.test(id) ? "tt" + id : id;
        }

        function setFeedback(message, isError) {
            feedback.textContent = message;
            feedback.className = isError ? "text-danger" : "text-success-emphasis";
        }

        function currentSource() {
            const checked = document.querySelector('input[name="gen_source"]:checked');
            return checked ? checked.value : "manual";
        }

        function toggleSource() {
            const source = currentSource();
            const isType = source === "type";
            const isImdb = source === "imdb";
            manualBlock.classList.toggle("d-none", isType || isImdb);
            typeBlock.classList.toggle("d-none", !isType);
            if (imdbBlock) imdbBlock.classList.toggle("d-none", !isImdb);
            // No modo IMDB o episódio vem da Temporada + Episódio Inicial, não de um ID avulso
            if (startIdCol) startIdCol.classList.toggle("d-none", isImdb);
            setFeedback("", false);
            if (isType) updateTypePreview();
        }

        function updateTypePreview() {
            if (!typeSelect) return;
            const opt = typeSelect.options[typeSelect.selectedIndex];
            const template = opt ? (opt.getAttribute("data-template") || "") : "";
            if (typePreview) typePreview.textContent = template;

            // Se o modelo foi salvo com o número real (sem {id}), sugere o ID inicial detectado
            if (template && !template.includes("{id}")) {
                const detected = detectNumber(template);
                if (detected) startId.value = detected.number;
            }
        }

        // Separa a query string / hash do restante da URL
        function splitQueryHash(url) {
            const i = url.search(/[?#]/);
            if (i === -1) return { core: url, tail: "" };
            return { core: url.slice(0, i), tail: url.slice(i) };
        }

        // Detecta o ultimo grupo de digitos do nome do arquivo, ignorando a extensao.
        // Ex: ".../luciano/92395.mp4" -> number "92395" (nao pega o "4" de mp4).
        function detectNumber(url) {
            const parts = splitQueryHash((url || "").trim());
            const extMatch = parts.core.match(/\.[A-Za-z0-9]+$/);
            const ext = extMatch ? extMatch[0] : "";
            const stem = ext ? parts.core.slice(0, parts.core.length - ext.length) : parts.core;
            const numMatch = stem.match(/(\d+)(?!.*\d)/);
            if (!numMatch) return null;
            const idx = numMatch.index;
            const num = numMatch[1];
            return {
                prefix: stem.slice(0, idx),
                suffix: stem.slice(idx + num.length) + ext + parts.tail,
                number: num
            };
        }

        function pad(value, width) {
            let s = String(value);
            while (width > 0 && s.length < width) s = "0" + s;
            return s;
        }

        function buildLines(prefix, suffix, start, total, padding) {
            const lines = [];
            for (let i = 0; i < total; i++) lines.push(prefix + pad(start + i, padding) + suffix);
            return lines.join("\n");
        }

        // No modo avulso, ao colar/editar a URL detecta o numero e sugere o ID inicial
        if (manualUrl) {
            manualUrl.addEventListener("input", function () {
                if (!manualUrl.value.trim()) { setFeedback("", false); return; }
                const detected = detectNumber(manualUrl.value);
                if (!detected) {
                    setFeedback("Nenhum número encontrado no final do link.", true);
                    return;
                }
                startId.value = detected.number;
                setFeedback("Número detectado: " + detected.number, false);
            });
        }

        sourceRadios.forEach(function (radio) {
            radio.addEventListener("change", toggleSource);
        });

        if (typeSelect) typeSelect.addEventListener("change", updateTypePreview);

        genBtn.addEventListener("click", function () {
            const total = parseInt(count.value, 10);
            if (!total || total < 1) {
                setFeedback("Informe uma quantidade válida.", true);
                return;
            }

            // Modo IMDB: monta os links do catálogo por temporada/episódio usando o imdb da série
            if (currentSource() === "imdb") {
                const imdbId = normalizeImdbId(SERIES_IMDB_ID);
                const providerSelect = document.getElementById("gen_imdb_provider");
                const providerBase = providerSelect && providerSelect.value ? providerSelect.value : STREAM_CATALOG_BASE_URL;
                const base = (providerBase || "").replace(/\/$/, "");
                if (!imdbId || !base) {
                    setFeedback("Série sem IMDb ID salvo ou nenhum provedor de catálogo selecionado.", true);
                    return;
                }

                const season = parseInt(document.getElementById("batch_season")?.value, 10) || 1;
                const startEp = parseInt(document.getElementById("batch_startEpisodeNumber")?.value, 10) || 1;

                const imdbLines = [];
                for (let i = 0; i < total; i++) {
                    imdbLines.push(`${base}/stream/series/${imdbId}:${season}:${startEp + i}.json`);
                }

                const imdbTextarea = target.value === "secondary"
                    ? document.getElementById("alternativeVideoUrlsText")
                    : document.getElementById("videoUrlsText");
                if (!imdbTextarea) return;

                imdbTextarea.value = imdbLines.join("\n");
                imdbTextarea.dispatchEvent(new Event("input", { bubbles: true }));

                // Catálogo é resolvido como mp4 (o resolver escolhe as qualidades reais)
                const formatSelect = document.getElementById("batch_videoStreamFormat");
                if (formatSelect) {
                    const mp4Option = Array.from(formatSelect.options).find(o => o.value.toLowerCase() === "mp4");
                    if (mp4Option) formatSelect.value = mp4Option.value;
                }

                const imdbTargetLabel = target.value === "secondary" ? "Segundo Link" : "Links Primários";
                setFeedback(`${total} link(s) IMDB gerado(s) em "${imdbTargetLabel}" (T${season}, a partir do EP${startEp}).`, false);
                return;
            }

            const startValue = (startId.value || "").trim();
            const start = parseInt(startValue, 10);
            if (isNaN(start)) {
                setFeedback("Informe o ID inicial (apenas números).", true);
                return;
            }

            let prefix, suffix, padding;

            if (currentSource() === "type") {
                const opt = typeSelect ? typeSelect.options[typeSelect.selectedIndex] : null;
                const template = opt ? (opt.getAttribute("data-template") || "") : "";
                const storedPadding = parseInt(opt ? opt.getAttribute("data-padding") : "0", 10) || 0;

                if (template.includes("{id}")) {
                    const split = template.split("{id}");
                    prefix = split[0];
                    suffix = split.slice(1).join("{id}");
                    padding = storedPadding;
                } else {
                    // Modelo salvo com o número real: detecta e usa como posição do ID
                    const detected = detectNumber(template);
                    if (!detected) {
                        setFeedback("O modelo precisa ter {id} ou um número no final.", true);
                        return;
                    }
                    prefix = detected.prefix;
                    suffix = detected.suffix;
                    padding = storedPadding > 0 ? storedPadding : (detected.number.startsWith("0") ? detected.number.length : 0);
                }
            } else {
                const detected = detectNumber(manualUrl.value);
                if (!detected) {
                    setFeedback("Cole um link válido com número no final.", true);
                    return;
                }
                prefix = detected.prefix;
                suffix = detected.suffix;
                // Mantem zeros a esquerda se o ID digitado (ou detectado) comeca com 0
                const padSource = startValue.startsWith("0") ? startValue : detected.number;
                padding = padSource.startsWith("0") ? padSource.length : 0;
            }

            const textarea = target.value === "secondary"
                ? document.getElementById("alternativeVideoUrlsText")
                : document.getElementById("videoUrlsText");

            if (!textarea) return;

            textarea.value = buildLines(prefix, suffix, start, total, padding);
            textarea.dispatchEvent(new Event("input", { bubbles: true }));

            const targetLabel = target.value === "secondary" ? "Segundo Link" : "Links Primários";
            setFeedback(total + " link(s) gerado(s) em \"" + targetLabel + "\".", false);
        });

        toggleSource();
    });
</script>
