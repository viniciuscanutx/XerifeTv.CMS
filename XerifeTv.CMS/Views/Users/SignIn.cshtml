@using XerifeTv.CMS.Modules.Authentication.Enums

@{
  ViewData["Title"] = "SignIn";
}

<style>
  .signin-form
  {
    max-width: 450px;
    border-radius: 0.85rem;
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-border-color-translucent);
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.18);
    position: relative;
    overflow: hidden;
  }

  .signin-form::before
  {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--xtv-accent);
  }

  @@media (max-width: 500px)
  {
    .signin-form
    {
      width: 100% !important;
    }
  }
</style>

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">

  <form
    id="signInForm"
    asp-controller="Users"
    asp-action="SignIn"
    class="w-50 p-4 py-5 signin-form">

    <input type="hidden" id="provider" name="provider" value="@((int)ELoginProvider.Basic)" />
    <input type="hidden" id="externalToken" name="externalToken" value="" />

    <div class="d-flex align-items-center justify-content-center gap-2 mb-4 pt-1">
      <span class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-2 fw-bold text-white shadow-sm"
            style="width: 2.5rem; height: 2.5rem; background: linear-gradient(135deg, var(--xtv-accent) 0%, var(--xtv-accent-active) 100%); font-size: 1.15rem;">
        C
      </span>
      <span class="fw-semibold fs-3">ChelifCMS</span>
    </div>

    <div class="mb-3">
      <label for="userNameOrEmail" class="form-label">Usuário ou E-mail</label>
      <input
        type="text"
        class="form-control"
        id="userNameOrEmail"
        name="userNameOrEmail"
        placeholder="digite aqui..."
        required>
    </div>
    <div class="mb-4">
      <label for="password" class="form-label">Senha</label>
      <div class="input-group">
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="digite aqui..."
          required>

        <div
          class="input-group-text fw-bold show-hide-password"
          style="font-size: 12px;"
          role="button">
          <i class="fa-regular fa-eye-slash"></i>
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-100">Login</button>
    
    <div id="googleSignInDiv" class="mt-3 w-100 d-flex justify-content-center">
      <div id="googleSignInBtn"></div>
    </div>

    <div class="w-100 d-flex justify-content-center align-items-center mt-4">
      <a
        href="@Url.Action("EmailResetPasswordForm")"
        role="button"
        class="link-offset-2 link-underline link-underline-opacity-0">
        Esqueci minha senha
      </a>
    </div>
  </form>
</div>

@section scripts {
    <script>
        function handleGoogleCredentialResponse(response) {
            const idToken = response.credential;
            $('#externalToken').val(idToken);
            $('#provider').val(@((int)ELoginProvider.Google));

            $('button').prop('disabled', true);
            $('input').prop('readonly', true);
            $('#signInForm').trigger('submit');
        }

        $(document).ready(function () {
            google.accounts.id.initialize({
                client_id: '@ViewBag.GoogleClientId',
                callback: handleGoogleCredentialResponse
            });

            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            const formWidth = document.getElementById('signInForm')?.offsetWidth;

            google.accounts.id.renderButton(
                document.getElementById('googleSignInBtn'), { 
                    theme: isDark ? 'filled_black' : 'outline', 
                    size: 'large',
                    width: formWidth ? formWidth - 64 : 350
                }
            );
        });
    </script>
}