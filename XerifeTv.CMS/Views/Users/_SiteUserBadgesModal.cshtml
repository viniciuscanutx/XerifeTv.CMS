@using XerifeTv.CMS.Modules.SiteBadge
@model XerifeTv.CMS.Modules.SiteUser.Dtos.Response.GetSiteUserResponseDto
@{ var badges = ViewBag.SiteBadges as IReadOnlyList<SiteBadgeResponse> ?? []; }
<div class="modal fade" id="userBadges-@Model.Id" tabindex="-1" aria-labelledby="userBadgesTitle-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" asp-controller="Users" asp-action="AssignSiteBadges" method="post">
            <input type="hidden" name="UserId" value="@Model.Id" />
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="userBadgesTitle-@Model.Id">Badges de @Model.Name</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p>Selecione os badges que este usuário poderá exibir no perfil.</p>
                @foreach (var badge in badges)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="BadgeIds" value="@badge.Id" id="userBadge-@Model.Id-@badge.Id" checked="@Model.BadgeIds.Contains(badge.Id)" />
                        <label class="form-check-label" for="userBadge-@Model.Id-@badge.Id"><span class="badge border" style="color:@badge.Color;border-color:@badge.Color !important">@badge.Name</span></label>
                    </div>
                }
                @if (badges.Count == 0) { <p class="text-muted">Nenhum badge cadastrado. <a asp-controller="SiteBadges" asp-action="Index">Cadastrar badges</a></p> }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar badges</button>
            </div>
        </form>
    </div>
</div>
