@using XerifeTv.CMS.Modules.SiteUser.Dtos.Response
@using XerifeTv.CMS.Modules.User.Dtos.Response

@model IEnumerable<GetUserResponseDto>

@{
    ViewData["Title"] = "Usuários";

    var userDtoEmpty = new GetUserResponseDto();
    var siteUserDtoEmpty = new GetSiteUserResponseDto();
    var siteUsers = ViewBag.SiteUsers as IEnumerable<GetSiteUserResponseDto> ?? [];
}

<div class="container">
    @await Html.PartialAsync("_UserFormModal", userDtoEmpty)
    @await Html.PartialAsync("_SiteUserFormModal", siteUserDtoEmpty)

    <header>
        <div class="d-flex align-items-center justify-content-between gap-4 flex-wrap">
            <span class="fs-3 fw-normal">Usuários</span>

            <a id="btnCreateCmsUser" class="btn btn-primary" role="button" data-bs-toggle="modal" data-bs-target="#userFormModal-@userDtoEmpty.Id">
                <i class="fa-solid fa-plus"></i> Cadastrar
            </a>
            <a id="btnCreateSiteUser" class="btn btn-primary d-none" role="button" data-bs-toggle="modal" data-bs-target="#siteUserFormModal-@siteUserDtoEmpty.Id">
                <i class="fa-solid fa-plus"></i> Cadastrar
            </a>
        </div>
        <hr />
    </header>

    <div class="row mt-2">
        <div class="col-12 d-flex justify-content-start align-items-center gap-3 flex-wrap mb-3">
            <div class="input-group" style="width: 17rem;">
                <span class="input-group-text">Exibindo</span>
                <select class="form-select shadow-none" id="userViewSelect">
                    <option value="cms" selected>Usuários do CMS</option>
                    <option value="site">Usuários do Site</option>
                </select>
            </div>
        </div>
    </div>

    <div id="cmsUsersSection">
        <div class="row gap-2 mt-4">
            <div class="table-responsive mt-4">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table">
                        <tr>
                            <th>Usuário</th>
                            <th>Email</th>
                            <th>Perfil</th>
                            <th>Status</th>
                            <th class="text-end">...</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @user.UserName
                                    </td>

                                    <td>
                                        @Html.Raw(!string.IsNullOrWhiteSpace(user.Email) ? user.Email : "----------")
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @user.RoleName
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.Blocked)
                                        {
                                            <span class="badge bg-danger">Bloqueado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Ativo</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary shadow-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#userFormModal-@user.Id"
                                                title="Editar usuário">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-circle-info me-2"></i>
                                    Nenhum registro encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Any())
            {
                @foreach (var user in Model) @await Html.PartialAsync("_UserFormModal", user)
            }
        </div>
    </div>

    <div id="siteUsersSection" class="d-none">
        <div class="row gap-2 mt-4">
            <div class="table-responsive mt-4">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table">
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th class="text-end">...</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (siteUsers.Any())
                        {
                            @foreach (var siteUser in siteUsers)
                            {
                                <tr>
                                    <td class="fw-semibold">@siteUser.Name</td>

                                    <td>
                                        @Html.Raw(!string.IsNullOrWhiteSpace(siteUser.Email) ? siteUser.Email : "----------")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(siteUser.RoleName))
                                        {
                                            <span class="badge bg-secondary">@siteUser.RoleName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sem role</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary shadow-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#siteUserFormModal-@siteUser.Id"
                                                title="Editar usuário do site">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="fa-solid fa-circle-info me-2"></i>
                                    Nenhum registro encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (siteUsers.Any())
            {
                @foreach (var siteUser in siteUsers) @await Html.PartialAsync("_SiteUserFormModal", siteUser)
            }
        </div>
    </div>
</div>

@section scripts {
    <script defer>
        function deleteUser(id) {
          if (!confirm('Deseja realmente remover o usuário?')) return;
          location.href = `/Users/Delete/${id}`
        }

        function deleteSiteUser(id) {
          if (!confirm('Deseja realmente remover o usuário do site?')) return;
          location.href = `/Users/DeleteSiteUser/${id}`
        }

        document.getElementById('userViewSelect').addEventListener('change', function () {
            const isSite = this.value === 'site';

            document.getElementById('cmsUsersSection').classList.toggle('d-none', isSite);
            document.getElementById('siteUsersSection').classList.toggle('d-none', !isSite);
            document.getElementById('btnCreateCmsUser').classList.toggle('d-none', isSite);
            document.getElementById('btnCreateSiteUser').classList.toggle('d-none', !isSite);
        });
    </script>
}
