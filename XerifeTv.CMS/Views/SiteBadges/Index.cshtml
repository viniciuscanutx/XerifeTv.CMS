@using XerifeTv.CMS.Modules.SiteBadge
@model IReadOnlyList<SiteBadgeResponse>
@{ ViewData["Title"] = "Badges do Site"; }
<div class="container">
    <header class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fs-3">Badges do Site</h1>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#badgeForm-new">Cadastrar badge</button>
    </header>
    <p class="text-muted">Crie os badges e atribua-os em Usuários do Site. Cada usuário escolhe qual exibir no perfil.</p>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Badge</th><th>Cor</th><th class="text-end">Ações</th></tr></thead>
            <tbody>
                @foreach (var badge in Model)
                {
                    <tr>
                        <td><span class="badge border" style="color:@badge.Color;border-color:@badge.Color !important">@badge.Name</span></td>
                        <td><span style="color:@badge.Color" aria-hidden="true">●</span> @badge.Color</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#badgeForm-@badge.Id">Editar</button>
                            <form asp-action="Delete" method="post" class="d-inline" data-confirm="Excluir este badge? Ele deixará de aparecer nos perfis.">
                                <input type="hidden" name="id" value="@badge.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhum badge cadastrado.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("_BadgeForm", new SaveSiteBadgeRequest())
@foreach (var badge in Model)
{
    @await Html.PartialAsync("_BadgeForm", new SaveSiteBadgeRequest { Id = badge.Id, Name = badge.Name, Color = badge.Color })
}
