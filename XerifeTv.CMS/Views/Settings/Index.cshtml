@using XerifeTv.CMS.Views.Settings.Models

@model SettingsModelView

@{
    ViewData["Title"] = "Configurações";
}

<style>
    .sub-menu-settings {
        min-width: 18%;
        height: 78vh;
        border-right: 1px solid #606060;

        @@media (max-width: 430px) {
            min-width: 100%;
            height: auto;
            border-right-color: transparent;
            border-bottom: 1px solid #606060;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }
    }

    .subtle-scrollbar {
        /* Firefox */
        scrollbar-width: thin;
        scrollbar-color: rgba(120, 120, 120, 0.45) transparent;
    }
        /* Chrome, Edge, Safari */
        .subtle-scrollbar::-webkit-scrollbar {
            width: 8px;
        }

        .subtle-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .subtle-scrollbar::-webkit-scrollbar-thumb {
            background-color: rgba(120, 120, 120, 0.25);
            border-radius: 8px;
            border: 2px solid transparent;
            background-clip: content-box;
            transition: background-color 0.2s ease;
        }

        .subtle-scrollbar:hover::-webkit-scrollbar-thumb {
            background-color: rgba(120, 120, 120, 0.5);
        }
</style>

<div class="container">
    <header>
        <div class="d-flex align-items-center justify-content-between gap-4">
            <span class="fs-3 fw-normal">Configurações</span>
        </div>
        <hr />
    </header>

    <div class="d-flex flex-column flex-md-row align-items-start">

        <div class="nav nav-pills me-3 d-flex flex-row flex-md-column gap-2 pe-3 sub-menu-settings"
             id="settings-tab"
             role="tablist"
             aria-orientation="vertical">

            <button class="nav-link d-flex align-items-center justify-content-start gap-2 ps-4 active"
                    id="v-pills-user-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#v-pills-user"
                    type="button"
                    role="tab"
                    aria-selected="true">
                <i class="fa-solid fa-user"></i>
                <span>Usuário</span>
            </button>


            @if (User.IsInRole("admin") || User.IsInRole("common"))
            {
                <button class="nav-link d-flex align-items-center justify-content-start gap-2 ps-4"
                        id="v-pills-import-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#v-pills-import"
                        type="button"
                        role="tab"
                        aria-selected="true">
                    <i class="fa-solid fa-file-import"></i>
                    <span>Importação</span>
                </button>
            }

            @if (User.IsInRole("admin"))
            {

                <button class="nav-link d-flex align-items-center justify-content-start gap-2 ps-4"
                        id="v-pills-integration-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#v-pills-integration"
                        type="button"
                        role="tab"
                        aria-selected="true">
                    <i class="fa-solid fa-circle-nodes"></i>
                    <span>Integrações</span>
                </button>
                
            }

            @if (User.IsInRole("admin"))
            {
                <button class="nav-link d-flex align-items-center justify-content-start gap-2 ps-4"
                        id="v-pills-streaming-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#v-pills-streaming"
                        type="button"
                        role="tab"
                        aria-selected="false">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Streaming</span>
                </button>
            }

            @if (User.IsInRole("admin") || User.IsInRole("common"))
            {
                <button class="nav-link d-flex align-items-center justify-content-start gap-2 ps-4"
                        id="v-pills-cache-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#v-pills-cache"
                        type="button"
                        role="tab"
                        aria-selected="false">
                    <i class="fa-solid fa-database"></i>
                    <span>Cache</span>
                </button>
            }


        </div>

        <div class="tab-content px-3 py-1 flex-grow-1" id="settings-tabContent">

            <div class="tab-pane fade show active"
                 id="v-pills-user"
                 role="tabpanel"
                 aria-labelledby="v-pills-user-tab">

                <ul class="nav nav-tabs mb-4" id="userTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="profile-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#profile"
                                type="button"
                                role="tab"
                                aria-selected="true">
                            Perfil
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="password-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#password"
                                type="button"
                                role="tab"
                                aria-selected="false">
                            Alterar senha
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="userTabsContent">

                    <div class="tab-pane fade show active"
                         id="profile"
                         role="tabpanel"
                         aria-labelledby="profile-tab">
                        @await Html.PartialAsync("_UserProfileForm", Model.UserSettingModel)
                    </div>

                    <div class="tab-pane fade"
                         id="password"
                         role="tabpanel"
                         aria-labelledby="password-tab">
                        @await Html.PartialAsync("_UserUpdatePasswordForm", Model.UserSettingModel)
                    </div>

                </div>
            </div>

            @if (User.IsInRole("admin") || User.IsInRole("common"))
            {
                <div class="tab-pane fade"
                     id="v-pills-import"
                     role="tabpanel"
                     aria-labelledby="v-pills-import-tab">

                    <ul class="nav nav-tabs mb-4" id="importTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="import-config-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#import-config"
                                    type="button"
                                    role="tab"
                                    aria-selected="true">
                                Configuração de Importação
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="search-config-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#search-config"
                                    type="button"
                                    role="tab"
                                    aria-selected="false">
                                Busca de Conteúdo
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="importTabsContent">
                        <div class="tab-pane fade show active"
                             id="import-config"
                             role="tabpanel"
                             aria-labelledby="import-config-tab">

                            <form asp-controller="Settings" asp-action="UpdateImportSettings" method="post" class="card p-4 shadow-sm border-0 bg-body-tertiary">
                                <h5 class="fw-bold mb-3"><i class="fa-solid fa-file-excel me-2 text-success"></i>Importação via Planilha (Excel)</h5>
                                <p class="text-muted fs-6 mb-4">Escolha em quais módulos você deseja habilitar ou ocultar os recursos de importação via planilha Excel.</p>

                                <div class="form-check form-switch fs-5 mb-3">
                                    <input class="form-check-input shadow-none"
                                           type="checkbox"
                                           role="switch"
                                           id="enableMoviesSpreadsheetImport"
                                           name="enableMoviesSpreadsheetImport"
                                           value="true"
                                           @(ViewBag.EnableMoviesSpreadsheetImport == true ? "checked" : "")>
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="enableMoviesSpreadsheetImport">
                                        <i class="fa-solid fa-film me-2 text-primary"></i> Habilitar importação por planilha para <span class="fw-bold">Filmes</span>
                                    </label>
                                </div>

                                <div class="form-check form-switch fs-5 mb-3">
                                    <input class="form-check-input shadow-none"
                                           type="checkbox"
                                           role="switch"
                                           id="enableSeriesSpreadsheetImport"
                                           name="enableSeriesSpreadsheetImport"
                                           value="true"
                                           @(ViewBag.EnableSeriesSpreadsheetImport == true ? "checked" : "")>
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="enableSeriesSpreadsheetImport">
                                        <i class="fa-solid fa-tv me-2 text-info"></i> Habilitar importação por planilha para <span class="fw-bold">Séries</span>
                                    </label>
                                </div>

                                <div class="form-check form-switch fs-5 mb-4">
                                    <input class="form-check-input shadow-none"
                                           type="checkbox"
                                           role="switch"
                                           id="enableChannelsSpreadsheetImport"
                                           name="enableChannelsSpreadsheetImport"
                                           value="true"
                                           @(ViewBag.EnableChannelsSpreadsheetImport == true ? "checked" : "")>
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="enableChannelsSpreadsheetImport">
                                        <i class="fa-solid fa-tower-cell me-2 text-warning"></i> Habilitar importação por planilha para <span class="fw-bold">Canais</span>
                                    </label>
                                </div>

                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Configuração
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade"
                             id="search-config"
                             role="tabpanel"
                             aria-labelledby="search-config-tab">

                            <form asp-controller="Settings" asp-action="UpdateSearchSettings" method="post" class="card p-4 shadow-sm border-0 bg-body-tertiary">
                                <h5 class="fw-bold mb-3"><i class="fa-solid fa-magnifying-glass me-2 text-success"></i>Busca de Filmes e Séries</h5>
                                <p class="text-muted fs-6 mb-4">Escolha como deseja preencher automaticamente os formulários de cadastro de Filmes e Séries. Você também pode alternar o modo diretamente no formulário, sem precisar voltar aqui.</p>

                                <div class="form-check mb-3">
                                    <input class="form-check-input shadow-none"
                                           type="radio"
                                           id="searchModeImdbId"
                                           name="imdbSearchMode"
                                           value="IMDB_ID"
                                           @(ViewBag.ImdbSearchMode?.ToString() != "NAME" ? "checked" : "")>
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="searchModeImdbId">
                                        Buscar por IMDB ID
                                    </label>
                                </div>

                                <div class="form-check mb-4">
                                    <input class="form-check-input shadow-none"
                                           type="radio"
                                           id="searchModeName"
                                           name="imdbSearchMode"
                                           value="NAME"
                                           @(ViewBag.ImdbSearchMode?.ToString() == "NAME" ? "checked" : "")>
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="searchModeName">
                                        Buscar por Nome
                                    </label>
                                </div>

                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Salvar Configuração
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (User.IsInRole("admin"))
            {
                <div class="tab-pane fade show"
                     id="v-pills-integration"
                     role="tabpanel"
                     aria-labelledby="v-pills-integration-tab">

                    <ul class="nav nav-tabs mb-4" id="integrationTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="webhook-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#webhook"
                                    type="button"
                                    role="tab"
                                    aria-selected="true">
                                Webhook
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="integrationTabsContent">

                        <div class="tab-pane fade show active"
                             id="webhook"
                             role="tabpanel"
                             aria-labelledby="webhook-tab">

                            @await Html.PartialAsync("_Webhooks", Model.WebHooks)

                        </div>
                    </div>
                </div>
            }

            @if (User.IsInRole("admin"))
            {
                <div class="tab-pane fade"
                     id="v-pills-streaming"
                     role="tabpanel"
                     aria-labelledby="v-pills-streaming-tab">

                    <ul class="nav nav-tabs mb-4" id="streamingTabs" role="tablist">

                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="media-delivery-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#media-delivery"
                                    type="button"
                                    role="tab"
                                    aria-selected="true">
                                Perfis de Entrega de Midia
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">

                        <div class="tab-pane fade show active"
                             id="media-delivery"
                             role="tabpanel"
                             aria-labelledby="media-delivery-tab">

                            @await Html.PartialAsync("_MediaDeliveryProfiles", Model.MediaDeliveryProfiles)

                        </div>

                    </div>
                </div>
            }

            @if (User.IsInRole("admin") || User.IsInRole("common"))
            {
                <div class="tab-pane fade"
                     id="v-pills-cache"
                     role="tabpanel"
                     aria-labelledby="v-pills-cache-tab">

                    <div class="row">
                        <div class="col-12 col-md-8 col-lg-7">
                            <div class="card bg-dark text-light border-secondary mb-4">
                                <div class="card-header border-secondary d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-database text-primary fs-5"></i>
                                    <h5 class="card-title mb-0">Gerenciamento de Cache da API</h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text text-secondary mb-3">
                                        O cache armazena temporariamente os dados de filmes, séries e canais em memória para otimizar o tempo de resposta da API de Conteúdo e reduzir a carga no servidor.
                                    </p>
                                    <p class="card-text text-secondary mb-4">
                                        Ao adicionar, alterar ou remover dados e desejar que as modificações apareçam imediatamente no aplicativo cliente, utilize o botão abaixo para limpar todo o cache em memória.
                                    </p>

                                    <form asp-controller="Settings" asp-action="ClearCache" method="post" onsubmit="return confirm('Tem certeza que deseja limpar todo o cache da API de Conteúdo?');">
                                        <button type="submit" class="btn btn-warning d-inline-flex align-items-center gap-2 fw-semibold px-4 py-2">
                                            <i class="fa-solid fa-broom"></i>
                                            Limpar Cache da API
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>


@section scripts {
    <script>
        $(document).ready(function () {

            function activateTabFromHash(hash) {
                if (!hash) return;

                const $targetTab = $(`.nav-link[data-bs-target="${hash}"]`);
                if (!$targetTab.length) return;

                const $parentPane = $targetTab.closest('.tab-pane');
                if ($parentPane.length) {
                    const parentId = '#' + $parentPane.attr('id');
                    const $parentTab = $(`.nav-link[data-bs-target="${parentId}"]`);

                    if ($parentTab.length) {
                        new bootstrap.Tab($parentTab[0]).show();
                    }
                }

                new bootstrap.Tab($targetTab[0]).show();
            }

            activateTabFromHash(window.location.hash);
        });
    </script>
}
