@using XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response

@model GetCatalogProviderResponseDto?

<div class="modal fade"
     id="catalogProviderFormModal-@Model?.Id"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="catalogProviderFormModal-@Model?.Id-Label"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form class="modal-content"
              asp-controller="CatalogProviders"
              asp-action="@(string.IsNullOrEmpty(Model?.Id) ? "Create" : "Update")">

            <input type="hidden" name="id" value="@Model?.Id" />

            <div class="modal-header">
                <h1 class="modal-title fs-5"
                    id="catalogProviderFormModal-@Model?.Id-Label">
                    @(string.IsNullOrEmpty(Model?.Id) ? "Cadastrar" : "Editar")
                    Provedor de Catálogo
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <div class="row mb-3">
                    <div class="col-12">
                        <label for="cp-name-@Model?.Id" class="form-label">Nome</label>
                        <input type="text"
                               class="form-control shadow-sm"
                               id="cp-name-@Model?.Id"
                               name="name"
                               placeholder="Ex: FrostStream"
                               value="@Model?.Name"
                               required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <label for="cp-baseUrl-@Model?.Id" class="form-label">Base URL</label>
                        <input type="text"
                               class="form-control shadow-sm"
                               id="cp-baseUrl-@Model?.Id"
                               name="baseUrl"
                               placeholder="https://froststream.cloutteam.com"
                               value="@Model?.BaseUrl"
                               required />
                        <small class="text-muted d-block mt-1">
                            Tudo <strong>antes</strong> de <code>/stream/...</code>, sem barra no final.
                            O link vira <code>{BaseUrl}/stream/movie/{imdb}.json</code> (filme) ou
                            <code>{BaseUrl}/stream/series/{imdb}:{temp}:{ep}.json</code> (série).
                            Ex fenixflix: <code>https://fenixflix.fenixhub.online/qualities=4k,1080p,720p,sd,cam|audio=dublado,legendado</code>
                        </small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="cp-idType-@Model?.Id" class="form-label">Tipo de ID</label>
                        @{ var isTmdb = string.Equals(Model?.IdType, "tmdb", StringComparison.OrdinalIgnoreCase); }
                        <select class="form-select shadow-sm" id="cp-idType-@Model?.Id" name="idType">
                            @if (isTmdb)
                            {
                                <option value="imdb">IMDb</option>
                                <option value="tmdb" selected>TMDB</option>
                            }
                            else
                            {
                                <option value="imdb" selected>IMDb</option>
                                <option value="tmdb">TMDB</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">
                            IMDb (ex: froststream, fenixflix) usa <code>tt...</code>; TMDB (ex: gaiaflix) usa o id numérico.
                        </small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label for="cp-order-@Model?.Id" class="form-label">Ordem de fallback</label>
                        <input type="number"
                               class="form-control shadow-sm"
                               id="cp-order-@Model?.Id"
                               name="order"
                               min="0"
                               value="@(Model?.Order ?? 0)" />
                        <small class="text-muted d-block mt-1">
                            Menor = tentado primeiro (1, 2, 3...). Se um provedor não tiver o título, tenta o próximo.
                        </small>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-6">
                        <div class="form-check">
                            <input id="cp-isDefault-@Model?.Id"
                                   name="isDefault"
                                   class="form-check-input"
                                   type="checkbox"
                                   value="@((Model?.IsDefault ?? false) ? "true" : "false")"
                                   @((Model?.IsDefault ?? false) ? "checked" : "") />
                            <label class="form-check-label" for="cp-isDefault-@Model?.Id">
                                Provedor padrão
                            </label>
                        </div>
                    </div>

                    @if (Model is GetCatalogProviderResponseDto && !string.IsNullOrEmpty(Model?.Id))
                    {
                        <div class="col-6">
                            <div class="form-check">
                                <input id="cp-isDisabled-@Model?.Id"
                                       name="isDisabled"
                                       class="form-check-input"
                                       type="checkbox"
                                       value="@(Model!.IsDisabled ? "true" : "false")"
                                       @(Model!.IsDisabled ? "checked" : "") />
                                <label class="form-check-label" for="cp-isDisabled-@Model?.Id">
                                    Desativar
                                </label>
                            </div>
                        </div>
                    }
                </div>

            </div>

            <div class="modal-footer d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">
                    @(string.IsNullOrEmpty(Model?.Id) ? "Cadastrar" : "Salvar")
                </button>

                @if (!string.IsNullOrEmpty(Model?.Id))
                {
                    <a role="button"
                       class="btn btn-danger btn-delete-catalog-provider-@Model?.Id">
                        <i class="fa fa-trash"></i>
                        Remover
                    </a>
                }
            </div>

        </form>
    </div>
</div>

<script>
    document.getElementById('cp-isDefault-@Model?.Id')?.addEventListener('change', function () {
        this.value = this.checked;
    });

    document.getElementById('cp-isDisabled-@Model?.Id')?.addEventListener('change', function () {
        this.value = this.checked;
    });

    document.querySelector('.btn-delete-catalog-provider-@Model?.Id')?.addEventListener('click', function () {
        if (!confirm('Deseja realmente remover este Provedor de Catálogo?')) return;

        location.href = '@Url.Action("Delete", "CatalogProviders", new { id = Model?.Id })';
    });
</script>
