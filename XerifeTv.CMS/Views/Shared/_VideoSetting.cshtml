@using XerifeTv.CMS.Views.Shared.Models
@using XerifeTv.CMS.Shared.Helpers

@inject IConfiguration Configuration

@model VideoSettingViewModel

@{
    var prefix = Model?.IdPrefix ?? string.Empty;
    bool isDeliverySelected = !string.IsNullOrWhiteSpace(Model?.MediaDeliveryProfileId);
    bool isStreamCatalog = !string.IsNullOrWhiteSpace(Model?.VideoUrl)
        && (Model.VideoUrl.Contains("/stream/", StringComparison.OrdinalIgnoreCase)
            || Model.VideoUrl.StartsWith("stream/", StringComparison.OrdinalIgnoreCase)
            || Model.VideoUrl.EndsWith(".json", StringComparison.OrdinalIgnoreCase));

    var streamCatalogBaseUrl = (Configuration["StreamCatalog:BaseUrl"] ?? string.Empty).TrimEnd('/');
    var catalogProviders = ViewBag.CatalogProviders as IEnumerable<XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response.GetCatalogProviderResponseDto>
                           ?? Enumerable.Empty<XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response.GetCatalogProviderResponseDto>();
    var streamFormats = (Model?.StreamFormats != null && Model.StreamFormats.Any())
                        ? Model.StreamFormats
                        : StreamFormatsHelper.Vod;
}

<fieldset class="border rounded p-3 mb-4">
    <legend class="float-none w-auto px-2 fs-5">Configuração de vídeo</legend>

    <div id="@($"{prefix}_video-direct-section")" class="row mb-3 @(isDeliverySelected ? "d-none" : "")">
        <div class="col-6">
            <label for="@($"{prefix}_videoUrl")" class="form-label">Video - Dublado (URL)</label>
            <input type="text"
                   class="form-control"
                   id="@($"{prefix}_videoUrl")"
                   name="videoUrl"
                   placeholder="https://video.com/video.m3u8"
                   value="@Model?.VideoUrl">
        </div>

        <div class="col-6">
            <label for="@($"{prefix}_videoStreamFormat")" class="form-label">Stream Format</label>
            <select class="form-select"
                    id="@($"{prefix}_videoStreamFormat")"
                    name="videoStreamFormat">

                <option selected value="">Selecione uma opção</option>

                @foreach (var format in streamFormats)
                {
                    if ((isStreamCatalog && string.IsNullOrWhiteSpace(Model?.VideoStreamFormat) && format == "mp4")
                        || format == Model?.VideoStreamFormat)
                    {
                        <option value="@format" selected>@format</option>
                    }
                    else
                    {
                        <option value="@format">@format</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model?.CatalogContentType))
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           id="@($"{prefix}_catalogByImdb")"
                           data-catalog-content-type="@Model.CatalogContentType"
                           data-catalog-imdb-id="@Model.CatalogImdbId"
                           data-catalog-season="@Model.CatalogSeason"
                           data-catalog-episode="@Model.CatalogEpisode"
                           data-catalog-episode-id="@Model.IdPrefix.Replace("episode_", string.Empty)"
                           data-catalog-base-url="@streamCatalogBaseUrl"
                           @(isStreamCatalog ? "checked" : "")>
                    <label class="form-check-label" for="@($"{prefix}_catalogByImdb")">
                        Pegar link por IMDb ID
                    </label>
                </div>
            </div>

            <div class="col-12 mt-2">
                <label for="@($"{prefix}_catalogProvider")" class="form-label mb-1" style="font-size: 13px;">Provedor do catálogo</label>
                <select class="form-select form-select-sm" id="@($"{prefix}_catalogProvider")">
                    @if (!catalogProviders.Any() && !string.IsNullOrWhiteSpace(streamCatalogBaseUrl))
                    {
                        <option value="@streamCatalogBaseUrl" data-id-type="imdb" selected>Padrão</option>
                    }
                    @foreach (var p in catalogProviders)
                    {
                        if (p.IsDefault)
                        {
                            <option value="@p.BaseUrl" data-id-type="@p.IdType" selected>@p.Name</option>
                        }
                        else
                        {
                            <option value="@p.BaseUrl" data-id-type="@p.IdType">@p.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    }

    <div id="@($"{prefix}_video-delivery-section")" class="@(!isDeliverySelected ? "d-none" : "")">
        <div class="row mb-3">
            <div class="col-6">
                <label for="@($"{prefix}_mediaDeliveryProfileId")" class="form-label">Perfil de entrega</label>
                <select class="form-select"
                        id="@($"{prefix}_mediaDeliveryProfileId")"
                        name="mediaDeliveryProfileId"
                        @(isDeliverySelected ? "required" : "")>
                    <option value="">Selecione um perfil</option>
                    @foreach (var profile in Model?.MediaDeliveryProfiles ?? [])
                    {
                        if (Model?.MediaDeliveryProfileId == profile?.Id)
                        {
                            <option value="@profile?.Id" selected>@profile?.Name</option>
                        }
                        else
                        {
                            <option value="@profile?.Id">@profile?.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-6">
                <label for="@($"{prefix}_mediaRoute")" class="form-label">Rota da mídia</label>
                <input type="text"
                       class="form-control"
                       id="@($"{prefix}_mediaRoute")"
                       name="mediaRoute"
                       value="@Model?.MediaRoute"
                       placeholder="/path/to/stream.m3u8"
                       @(isDeliverySelected ? "required" : "")>
            </div>
        </div>
    </div>

    @* Assim como o checkbox abaixo, fica fora dos blocos alternados por videoSourceType:
       o link legendado e sempre URL fixa, inclusive quando o link principal usa
       Perfil de Entrega. *@
    @if (Model?.IsShowAlternativeVideoUrlInput == true)
    {
        <div class="row mb-3">
            <div class="col-12">
                <label for="@($"{prefix}_alternativeVideoUrl")" class="form-label">Video - Legendado (URL)</label>
                <input type="text"
                       class="form-control"
                       id="@($"{prefix}_alternativeVideoUrl")"
                       name="alternativeVideoUrl"
                       placeholder="https://video.com/video-legendado.m3u8"
                       value="@Model?.AlternativeVideoUrl">
                <small class="text-muted">Link primário acima = Dublado. Este link = Legendado (caso exista).</small>
            </div>
        </div>
    }

    @* Fica fora dos blocos alternados por videoSourceType de proposito: a flag vale
       para qualquer URL fixa do cadastro, inclusive o link legendado, que continua
       sendo URL fixa mesmo quando o link principal usa Perfil de Entrega. *@
    <div class="row mb-3">
        <div class="col-12">
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       id="@($"{prefix}_followRedirect")"
                       name="followRedirect"
                       value="true"
                       @(Model?.FollowRedirect == true ? "checked" : "")>
                <label class="form-check-label" for="@($"{prefix}_followRedirect")">
                    Com redirecionamento
                </label>
                <div class="form-text">
                    Marque quando a URL nao aponta direto para o arquivo, e sim redireciona para ele.
                    Vale para o link dublado e tambem para o link legendado, quando houver.
                    O link final e resolvido no momento de tocar, entao continua funcionando se o destino mudar a cada acesso.
                    Nao se aplica a links montados por Perfil de Entrega.
                </div>
            </div>
        </div>
    </div>

    @if (Model?.IsShowVideoSubtitleInput == true)
    {
        <div class="row mb-4">
            <div class="col-12">
                <label for="@($"{prefix}_videoSubtitle")" class="form-label">Legenda (URL)</label>
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           id="@($"{prefix}_videoSubtitle")"
                           name="videoSubtitle"
                           placeholder="https://subtitle.com/vtts/video.vtt"
                           value="@Model?.VideoSubtitle" />

                    <input id="@($"{prefix}_subtitle_file")"
                           type="file"
                           accept=".vtt,.srt"
                           style="display: none" />

                    <button id="@($"{prefix}_btn_subtitle_file")"
                            class="btn btn-success"
                            type="button">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </button>
                </div>
            </div>
        </div>
    }

</fieldset>
