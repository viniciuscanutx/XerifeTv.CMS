@inject IConfiguration Configuration
@inject XerifeTv.CMS.Modules.CatalogProvider.Interfaces.ICatalogProviderService CatalogProviderService

@{
    var _catalogProviders = (await CatalogProviderService.GetAllAsync()).Data
        ?? Enumerable.Empty<XerifeTv.CMS.Modules.CatalogProvider.Dtos.Response.GetCatalogProviderResponseDto>();
    var _catalogProviderBasesJson = System.Text.Json.JsonSerializer.Serialize(_catalogProviders.Select(p => p.BaseUrl));
}

<div class="modal fade"
     id="videoModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="videoModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="videoModalLabel"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="height: 65vh; position: relative;">
                <video id="player"
                       class="video-js vjs-default-skin w-100"
                       style="min-height: 100%; max-height: 100%;"
                       controls>
                </video>
                <div id="videoLoadingOverlay"
                     style="display: none; position: absolute; inset: 0; z-index: 5;
                            align-items: center; justify-content: center; flex-direction: column;
                            gap: .75rem; background: rgba(0,0,0,.65); color: #fff; text-align: center;">
                    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <div id="videoLoadingText" class="small">Carregando vídeo...</div>
                </div>
                <div id="videoErrorOverlay"
                     style="display: none; position: absolute; inset: 0; z-index: 5;
                            align-items: center; justify-content: center; flex-direction: column;
                            gap: .5rem; background: rgba(0,0,0,.75); color: #fff; text-align: center; padding: 1rem;">
                    <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
                    <div id="videoErrorText" class="small">Não foi possível carregar o vídeo.</div>
                </div>
            </div>
            <div class="modal-footer justify-content-center" id="videoLangSwitcher" style="display: none;">
                <div class="btn-group" role="group" aria-label="Seleção de idioma do vídeo">
                    <button type="button" class="btn btn-sm btn-outline-primary active" id="btnDub" data-lang="dub">
                        <i class="fa-solid fa-volume-high"></i> Dublado
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLeg" data-lang="leg">
                        <i class="fa-solid fa-closed-captioning"></i> Legendado
                    </button>
                </div>
            </div>
            <div class="modal-footer justify-content-center gap-2" id="subtitleSyncControls" style="display: none;">
                <span class="text-muted small"><i class="fa-solid fa-closed-captioning me-1"></i> Sincronizar legenda:</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Sincronizar legenda">
                    <button type="button" class="btn btn-outline-secondary" id="subOffsetMinus" title="Atrasar 0,5s">−0,5s</button>
                    <button type="button" class="btn btn-outline-secondary" id="subOffsetReset" title="Zerar">0s</button>
                    <button type="button" class="btn btn-outline-secondary" id="subOffsetPlus" title="Adiantar 0,5s">+0,5s</button>
                </div>
                <span class="small" id="subOffsetValue" style="min-width: 3.5rem; text-align: left;">0,0s</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* Botão de Fonte na barra do player: mostra a fonte atual como texto (sem ícone) */
    .video-js .vjs-fonte-menu-button { width: auto; }
    .video-js .vjs-fonte-menu-button .vjs-icon-placeholder {
        font-family: inherit;
        font-size: 1em;
        font-weight: 600;
        line-height: 3em;
        padding: 0 .5em;
    }
    .video-js .vjs-fonte-menu-button .vjs-icon-placeholder:before { content: none; }
    .video-js .vjs-fonte-menu-button .vjs-menu-content { max-height: 20em; }
</style>

<script defer>
    const modal = document.getElementById('videoModal')
    let player = undefined
    let currentDubResolver = null
    let currentLegResolver = null
    let currentLang = 'dub'
    let currentSources = []
    let currentSourceUrl = null
    let fonteButton = null

    // Sincronização de legenda: desloca o tempo das cues por um offset (+/-).
    let subtitleTrackEl = null
    let subtitleOffset = 0
    let subtitleOriginals = []

    function updateSubtitleOffsetDisplay() {
        const el = document.getElementById('subOffsetValue')
        if (el) el.textContent = `${subtitleOffset > 0 ? '+' : ''}${subtitleOffset.toFixed(1).replace('.', ',')}s`
    }

    function captureSubtitleOriginals() {
        subtitleOriginals = []
        const track = subtitleTrackEl && subtitleTrackEl.track
        if (!track || !track.cues) return
        for (let i = 0; i < track.cues.length; i++) {
            const cue = track.cues[i]
            subtitleOriginals.push({ cue, start: cue.startTime, end: cue.endTime })
        }
    }

    function applySubtitleOffset() {
        // captura os tempos originais na primeira vez que as cues existirem
        if (subtitleOriginals.length === 0) captureSubtitleOriginals()
        subtitleOriginals.forEach(o => {
            o.cue.startTime = Math.max(0, o.start + subtitleOffset)
            o.cue.endTime = Math.max(0, o.end + subtitleOffset)
        })
        updateSubtitleOffsetDisplay()
    }

    function changeSubtitleOffset(delta) {
        subtitleOffset = delta === 0 ? 0 : Math.round((subtitleOffset + delta) * 10) / 10
        applySubtitleOffset()
    }

    function setupSubtitleSync(trackEl) {
        subtitleTrackEl = trackEl
        subtitleOffset = 0
        subtitleOriginals = []
        const controls = document.getElementById('subtitleSyncControls')
        if (controls) controls.style.display = 'flex'
        updateSubtitleOffsetDisplay()
        // as cues só carregam quando a legenda é ativada; reaplica o offset quando carregarem
        if (trackEl && trackEl.track) {
            trackEl.addEventListener('load', () => { subtitleOriginals = []; applySubtitleOffset() })
        }
    }

    function resetSubtitleSync() {
        subtitleTrackEl = null
        subtitleOffset = 0
        subtitleOriginals = []
        const controls = document.getElementById('subtitleSyncControls')
        if (controls) controls.style.display = 'none'
    }

    // Botão de menu "Fonte" na barra do player: lista todas as fontes do array e troca a fonte ao clicar.
    function ensureFonteComponent() {
        if (typeof videojs === 'undefined' || videojs.getComponent('FonteMenuButton')) return
        const MenuButton = videojs.getComponent('MenuButton')
        const MenuItem = videojs.getComponent('MenuItem')

        class FonteMenuItem extends MenuItem {
            constructor(player, options) {
                super(player, { label: options.label, selectable: true, selected: !!options.selected })
                this._source = options.source
                this._parentButton = options.parentButton
            }
            handleClick() {
                super.handleClick()
                if (this._parentButton) this._parentButton.selectSource(this._source)
            }
        }

        class FonteMenuButton extends MenuButton {
            constructor(player, options) {
                super(player, options)
                this.controlText('Fonte')
                this.addClass('vjs-fonte-menu-button')
            }
            setData(sources, currentUrl, onSelect) {
                this._sources = sources || []
                this._currentUrl = currentUrl
                this._onSelect = onSelect
                this.update()
                this.refreshLabel()
            }
            refreshLabel() {
                const list = this._sources || []
                const cur = list.find(s => (s.url || s.Url) === this._currentUrl) || list[0]
                const text = cur ? (cur.quality || cur.Quality || 'Fonte') : 'Fonte'
                const placeholder = this.el().querySelector('.vjs-icon-placeholder')
                if (placeholder) placeholder.textContent = text
            }
            // Atualiza a fonte atual sem disparar o onSelect (usado no auto-fallback de erro)
            setCurrent(url) {
                this._currentUrl = url
                this.update()
                this.refreshLabel()
            }
            selectSource(source) {
                this._currentUrl = source.url || source.Url
                this.update()
                this.refreshLabel()
                this.unpressButton()
                if (this._onSelect) this._onSelect(source)
            }
            createItems() {
                return (this._sources || []).map(source => new FonteMenuItem(this.player(), {
                    label: source.quality || source.Quality || 'Fonte',
                    source,
                    selected: (source.url || source.Url) === this._currentUrl,
                    parentButton: this
                }))
            }
        }

        videojs.registerComponent('FonteMenuItem', FonteMenuItem)
        videojs.registerComponent('FonteMenuButton', FonteMenuButton)
    }
    // URL do Worker (cache KV compartilhado). Vazio = pula o Worker e vai direto no froststream.
    const streamCatalogProxyBaseUrl = '@((Configuration["StreamCatalog:ProxyBaseUrl"] ?? string.Empty).TrimEnd('/'))'
    // Bases dos provedores na ordem de fallback (1, 2, 3...). Vazio = usa só a URL cadastrada.
    const CATALOG_PROVIDER_BASES = @Html.Raw(_catalogProviderBasesJson)

    function setLoading(visible, text) {
        const overlay = document.getElementById('videoLoadingOverlay')
        if (!overlay) return
        if (visible) hideError()
        const label = document.getElementById('videoLoadingText')
        if (text && label) label.textContent = text
        overlay.style.display = visible ? 'flex' : 'none'
    }

    function hideError() {
        const overlay = document.getElementById('videoErrorOverlay')
        if (overlay) overlay.style.display = 'none'
    }

    function showError(text) {
        setLoading(false)
        const overlay = document.getElementById('videoErrorOverlay')
        if (!overlay) return
        const label = document.getElementById('videoErrorText')
        if (text && label) label.textContent = text
        overlay.style.display = 'flex'
    }

    function getSources(data) {
        const sources = data.sources || data.Sources || data.streams || []
        return Array.isArray(sources) ? sources : []
    }

    function extractSourceUrl(value) {
        if (typeof value !== 'string') return ''

        const normalized = value.trim()
            .replace(/\\\[/g, '[')
            .replace(/\\\]/g, ']')
            .replace(/\\_/g, '_')
        const markdownStart = normalized.indexOf('](')
        const url = normalized.startsWith('[') && markdownStart > 0
            ? normalized.slice(markdownStart + 2).replace(/\)$/, '')
            : normalized

        return url.trim().replace(/^<|>$/g, '')
    }

    function getStreamFormat(url) {
        const path = String(url || '').split('?')[0].split('#')[0]
        const extension = path.split('.').pop()?.toLowerCase()
        return extension || (url.includes('.m3u8') ? 'hls' : 'mp4')
    }

    function getQuality(...values) {
        const pattern = /(?<![a-z0-9])(4k|2160p|1440p|1080p|720p|576p|480p|360p)(?![a-z0-9])/i
        for (const value of values) {
            const match = pattern.exec(typeof value === 'string' ? value : '')
            if (!match) continue

            const raw = match[1].toLowerCase()
            return {
                key: raw,
                label: raw === '4k' ? '4K' : raw
            }
        }

        return { key: 'auto', label: 'Auto' }
    }

    function qualityRank(value) {
        if (value === '4k') return 2160
        const rank = Number.parseInt(value, 10)
        return Number.isFinite(rank) ? rank : 0
    }

    function normalizeSources(data) {
        // Dedup por URL (não por qualidade) pra manter TODAS as fontes do array.
        // O rótulo já vem do servidor (nome da fonte de mídia).
        const unique = new Map()

        getSources(data).forEach(source => {
            const url = extractSourceUrl(source.url || source.Url)
            if (!url || unique.has(url)) return

            unique.set(url, {
                ...source,
                url,
                quality: source.quality || source.Quality
                    || getQuality(null, source.name || source.Name, source.title || source.Title, url).label,
                streamFormat: source.streamFormat || source.StreamFormat || getStreamFormat(url)
            })
        })

        // Mantém a ordem que o servidor mandou (já vem por qualidade desc).
        return [...unique.values()]
    }

    function updateSourceMenu(sources) {
        currentSources = sources || []
        if (!fonteButton) return

        const initialUrl = currentSourceUrl
            || (currentSources[0] && (currentSources[0].url || currentSources[0].Url))
            || null

        fonteButton.setData(currentSources, initialUrl, async (source) => { await playSource(source) })

        if (currentSources.length > 1) fonteButton.show()
        else fonteButton.hide()
    }

    const resolvedSourceCache = new Map()

    async function getPlayableSource(source) {
        const sourceUrl = extractSourceUrl(source.url || source.Url)
        if (!sourceUrl) return null
        if (resolvedSourceCache.has(sourceUrl)) return resolvedSourceCache.get(sourceUrl)

        const streamFormat = (source.streamFormat || source.StreamFormat || getStreamFormat(sourceUrl)).toLowerCase()
        const params = new URLSearchParams({
            urlFixed: sourceUrl,
            streamFormat: streamFormat || 'mp4',
            followRedirect: 'false'
        })

        const promise = fetch('/MediaDeliveryProfiles/ResolveUrlFixed?' + params.toString(), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        })
            .then(response => {
                if (!response.ok) throw new Error('Erro ao gerar o proxy da fonte')
                return response.json()
            })
            .then(data => ({
                ...source,
                url: data.url || data.Url || sourceUrl,
                streamFormat: data.streamFormat || data.StreamFormat || streamFormat
            }))

        resolvedSourceCache.set(sourceUrl, promise)
        return promise
    }

    async function playSource(source) {
        const sourceUrl = extractSourceUrl(source.url || source.Url)
        if (!sourceUrl) return

        const playableSource = await getPlayableSource(source)
        if (!playableSource) return

        const url = playableSource.url
        const streamFormat = (playableSource.streamFormat || playableSource.StreamFormat || '').toLowerCase()

        currentSourceUrl = sourceUrl
        // type explícito por formato: fontes sem extensão na URL (ex: koyeb do fenixflix)
        // seriam rejeitadas de cara pelo video.js sem essa dica.
        const mimeTypes = {
            hls: 'application/x-mpegURL',
            m3u8: 'application/x-mpegURL',
            mp4: 'video/mp4',
            m4v: 'video/mp4',
            mkv: 'video/x-matroska',
            webm: 'video/webm',
            mov: 'video/quicktime',
            ogv: 'video/ogg'
        }

        const type = mimeTypes[streamFormat]
        player.src(type ? { src: url, type } : { src: url })

        if (fonteButton) fonteButton.setCurrent(sourceUrl)
    }

    function isCatalogUrl(value) {
        if (!value) return false
        const normalized = String(value).toLowerCase()
        // só o endpoint de catálogo do gaiaflix (movie-source), não o de HLS
        return normalized.includes('/stream/') || normalized.endsWith('.json') || normalized.includes('gaiaflix-movie-source')
    }

    // O froststream bloqueia o IP de datacenter do Render/Worker de forma intermitente,
    // mas o navegador do admin (IP residencial) sempre passa e o froststream libera CORS.
    // Então buscamos o catálogo aqui no browser e mandamos o JSON pro servidor só montar
    // as fontes - sem o servidor precisar falar com o froststream. Se qualquer passo
    // falhar, retorna null e o fluxo cai no resolver do servidor (comportamento antigo).
    function catalogHasStreams(text) {
        try {
            const parsed = JSON.parse(text)
            // stremio usa "streams", gaiaflix usa "sources"
            return (Array.isArray(parsed.streams) && parsed.streams.length > 0)
                || (Array.isArray(parsed.sources) && parsed.sources.length > 0)
        } catch {
            return false
        }
    }

    // Busca o catálogo de UMA URL: tenta o KV do Worker primeiro; no miss, busca no
    // navegador (IP residencial passa) e grava no Worker pra próxima. Retorna o texto ou null.
    async function fetchCatalogPayload(url) {
        if (streamCatalogProxyBaseUrl) {
            try {
                const kv = await fetch(
                    `${streamCatalogProxyBaseUrl}/?kvOnly=1&url=${encodeURIComponent(url)}`,
                    { headers: { Accept: 'application/json' } })
                if (kv.ok) return await kv.text()
            } catch { /* segue pro browser */ }
        }

        try {
            const r = await fetch(url, { headers: { Accept: 'application/json' } })
            if (!r.ok) return null
            const text = await r.text()

            if (streamCatalogProxyBaseUrl) {
                fetch(`${streamCatalogProxyBaseUrl}/?url=${encodeURIComponent(url)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: text
                }).catch(() => {})
            }
            return text
        } catch {
            return null
        }
    }

    async function resolveCatalogViaBrowser(resolverUrl) {
        let parsed
        try {
            parsed = new URL(resolverUrl, window.location.origin)
        } catch {
            return null
        }

        if (!parsed.pathname.endsWith('/ResolveUrlFixed')) return null

        const urlFixed = parsed.searchParams.get('urlFixed')
        if (!isCatalogUrl(urlFixed)) return null

        const streamFormat = parsed.searchParams.get('streamFormat') || 'mp4'
        const followRedirect = (parsed.searchParams.get('followRedirect') || 'false').toLowerCase() === 'true'

        // Monta a lista de URLs candidatas: cada provedor (na ordem de fallback) + o
        // sufixo /stream/...json extraído da URL cadastrada. A URL original entra por
        // último como garantia. Assim, se o provedor 1 não tiver o título, tenta o 2, 3...
        const suffixIdx = urlFixed.indexOf('/stream/')
        const suffix = suffixIdx >= 0 ? urlFixed.substring(suffixIdx) : null

        const candidates = []
        if (suffix && Array.isArray(CATALOG_PROVIDER_BASES)) {
            CATALOG_PROVIDER_BASES.forEach(base => {
                const candidate = String(base).replace(/\/$/, '') + suffix
                if (!candidates.includes(candidate)) candidates.push(candidate)
            })
        }
        if (!candidates.includes(urlFixed)) candidates.push(urlFixed)

        let payload = null
        let chosenUrl = null
        for (const candidate of candidates) {
            const text = await fetchCatalogPayload(candidate)
            if (text && catalogHasStreams(text)) {
                payload = text
                chosenUrl = candidate
                break
            }
        }

        // Nenhum provedor tinha o título: deixa cair no fallback do servidor
        if (!payload) return null

        // Servidor monta as fontes (probe + proxy) a partir do catálogo escolhido
        const response = await fetch('/MediaDeliveryProfiles/ResolveCatalogFromPayload', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ urlFixed: chosenUrl, streamFormat, followRedirect, payload })
        })
        if (!response.ok) throw new Error('Falha ao resolver catálogo por payload')
        return await response.json()
    }

    async function resolveAndPlay(resolverUrl) {
        setLoading(true, 'Carregando vídeo...')
        try {
            let data = null

            try {
                data = await resolveCatalogViaBrowser(resolverUrl)
            } catch (browserErr) {
                console.warn('Resolução via navegador falhou, usando servidor:', browserErr)
                data = null
            }

            if (!data) {
                const response = await fetch(resolverUrl)
                if (!response.ok) throw new Error('Erro ao resolver URL')
                data = await response.json()
            }

            const url = data.url || data.Url
            const streamFormat = data.streamFormat || data.StreamFormat
            const sources = normalizeSources(data)

            if (sources.length > 0) {
                updateSourceMenu(sources)
                await playSource(sources[0])
                setLoading(false)
                return
            }

            updateSourceMenu([])
            await playSource({ url: extractSourceUrl(url), streamFormat })
            setLoading(false)
        }
        catch (err) {
            console.error('Erro ao carregar vídeo:', err)
            showError('Não foi possível carregar o vídeo. Tente novamente.')
        }
    }

    if (modal) {
        modal.addEventListener('show.bs.modal', async event => {
            const button = event.relatedTarget

            const modalTitle = modal.querySelector('#videoModalLabel') || modal.querySelector('.modal-title')
            if (modalTitle && button) {
                modalTitle.textContent = button.getAttribute('data-bs-title') || ''
            }

            if (!player) {
                player = videojs('player', {
                    controls: true,
                    preload: 'auto',
                    playbackRates: [0.5, 1, 1.25, 1.5, 2],
                    controlBar: {
                        skipButtons: {
                            forward: 10,
                            backward: 10
                        }
                    }
                })

                // Botão de Fonte na barra (substitui o dropdown de baixo e o quality do HLS)
                ensureFonteComponent()
                const fsToggle = player.controlBar.getChild('fullscreenToggle')
                const insertIndex = fsToggle ? player.controlBar.children().indexOf(fsToggle) : undefined
                fonteButton = player.controlBar.addChild('FonteMenuButton', {}, insertIndex)
                fonteButton.hide()

                // Auto-fallback: se a fonte atual falhar, tenta a próxima da lista.
                // Só mostra erro quando todas as fontes falharem.
                player.on('error', () => {
                    const idx = currentSources.findIndex(s => (s.url || s.Url) === currentSourceUrl)
                    const next = idx >= 0 ? currentSources[idx + 1] : null
                    if (next) {
                        console.warn('Fonte falhou, tentando a próxima:', currentSourceUrl)
                        setLoading(true, 'Tentando outra fonte...')
                        playSource(next)
                    } else {
                        showError('Não foi possível carregar o vídeo em nenhuma fonte.')
                    }
                })

                player.on('playing', () => setLoading(false))
                player.on('loadeddata', () => setLoading(false))
            }

            currentDubResolver = button.getAttribute('data-bs-video-resolver')
            currentLegResolver = button.getAttribute('data-bs-video-alternative-resolver')
            currentSourceUrl = null
            updateSourceMenu([])

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const langSwitcher = document.getElementById('videoLangSwitcher')
            const btnDub = document.getElementById('btnDub')
            const btnLeg = document.getElementById('btnLeg')

            if (btnDub) btnDub.classList.remove('active')
            if (btnLeg) btnLeg.classList.remove('active')

            if (hasDub && hasLeg) {
                if (langSwitcher) langSwitcher.style.display = 'flex'
                if (btnDub) {
                    btnDub.style.display = 'inline-block'
                    btnDub.classList.add('active')
                }
                if (btnLeg) {
                    btnLeg.style.display = 'inline-block'
                }
                currentLang = 'dub'
            } else {
                if (langSwitcher) langSwitcher.style.display = 'none'
                if (hasLeg) {
                    currentLang = 'leg'
                } else {
                    currentLang = 'dub'
                }
            }

            const initialResolver = (currentLang === 'leg' && hasLeg) ? currentLegResolver : currentDubResolver
            if (initialResolver && initialResolver.trim() !== '') {
                await resolveAndPlay(initialResolver, currentLang)
            }

            const subtitle = button.getAttribute('data-bs-video-subtitle')

            resetSubtitleSync()
            if (subtitle) {
                const trackEl = player.addRemoteTextTrack({
                    kind: 'captions',
                    src: subtitle,
                    srclang: 'pt',
                    label: 'Português'
                }, false)
                setupSubtitleSync(trackEl)
            }
        })

        modal.addEventListener('hide.bs.modal', () => {
            setLoading(false)
            hideError()
            resetSubtitleSync()
            if (player) {
                player.pause()
                player.reset()
            }
        })
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btnDub = document.getElementById('btnDub')
        const btnLeg = document.getElementById('btnLeg')

        document.getElementById('subOffsetMinus')?.addEventListener('click', () => changeSubtitleOffset(-0.5))
        document.getElementById('subOffsetPlus')?.addEventListener('click', () => changeSubtitleOffset(0.5))
        document.getElementById('subOffsetReset')?.addEventListener('click', () => changeSubtitleOffset(0))

        async function switchLang(lang) {
            if (lang === currentLang) return

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const btnDubEl = document.getElementById('btnDub')
            const btnLegEl = document.getElementById('btnLeg')

            if (lang === 'dub' && hasDub) {
                btnDubEl?.classList.add('active')
                btnLegEl?.classList.remove('active')
                currentLang = 'dub'
                await resolveAndPlay(currentDubResolver, lang)
            } else if (lang === 'leg' && hasLeg) {
                btnLegEl?.classList.add('active')
                btnDubEl?.classList.remove('active')
                currentLang = 'leg'
                await resolveAndPlay(currentLegResolver, lang)
            }
        }

        btnDub?.addEventListener('click', () => switchLang('dub'))
        btnLeg?.addEventListener('click', () => switchLang('leg'))
    })
</script>
