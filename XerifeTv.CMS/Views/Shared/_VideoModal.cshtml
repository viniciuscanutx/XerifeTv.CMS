
<div class="modal fade"
     id="videoModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="videoModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="videoModalLabel"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="height: 65vh;">
                <video id="player"
                       class="video-js vjs-default-skin w-100"
                       style="min-height: 100%; max-height: 100%;"
                       controls>
                </video>
            </div>
            <div class="modal-footer justify-content-center" id="videoLangSwitcher" style="display: none;">
                <div class="btn-group" role="group" aria-label="Seleção de idioma do vídeo">
                    <button type="button" class="btn btn-sm btn-outline-primary active" id="btnDub" data-lang="dub">
                        <i class="fa-solid fa-volume-high"></i> Dublado
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLeg" data-lang="leg">
                        <i class="fa-solid fa-closed-captioning"></i> Legendado
                    </button>
                </div>
            </div>
            <div class="modal-footer justify-content-center" id="videoQualitySwitcher" style="display: none;">
                <label for="videoQualitySelect" class="form-label mb-0">Qualidade</label>
                <select class="form-select form-select-sm w-auto" id="videoQualitySelect" aria-label="Qualidade do vídeo"></select>
            </div>
        </div>
    </div>
</div>

<script defer>
    const modal = document.getElementById('videoModal')
    let player = undefined
    let currentDubResolver = null
    let currentLegResolver = null
    let currentLang = 'dub'
    let currentSources = []
    let currentSourceUrl = null

    function getSources(data) {
        const sources = data.sources || data.Sources || []
        return Array.isArray(sources) ? sources : []
    }

    function updateQualitySelector(sources) {
        const switcher = document.getElementById('videoQualitySwitcher')
        const select = document.getElementById('videoQualitySelect')
        if (!switcher || !select) return

        select.innerHTML = ''
        currentSources = sources

        sources.forEach(source => {
            const quality = source.quality || source.Quality || 'Auto'
            const url = source.url || source.Url
            if (!url) return

            const option = document.createElement('option')
            option.value = url
            option.textContent = quality
            select.appendChild(option)
        })

        switcher.style.display = sources.length > 1 ? 'flex' : 'none'
        select.value = currentSourceUrl || (sources[0]?.url || sources[0]?.Url || '')
        select.onchange = async () => {
            const selectedSource = currentSources.find(source => (source.url || source.Url) === select.value)
            if (selectedSource) await playSource(selectedSource)
        }
    }

    async function playSource(source) {
        const url = source.url || source.Url
        const streamFormat = (source.streamFormat || source.StreamFormat || '').toLowerCase()
        if (!url) return

        currentSourceUrl = url
        const playlistMimeTypes = {
            hls: 'application/x-mpegURL',
            m3u8: 'application/x-mpegURL'
        }

        const playlistType = playlistMimeTypes[streamFormat]
        player.src(playlistType ? { src: url, type: playlistType } : { src: url })
    }

    async function resolveAndPlay(resolverUrl) {
        try {
            const response = await fetch(resolverUrl)
            if (!response.ok) throw new Error('Erro ao resolver URL')

            const data = await response.json()
            const url = data.url || data.Url
            const streamFormat = data.streamFormat || data.StreamFormat
            const sources = getSources(data)

            if (sources.length > 0) {
                updateQualitySelector(sources)
                await playSource(sources[0])
                return
            }

            updateQualitySelector([])
            await playSource({ url, streamFormat })
        }
        catch (err) {
            console.error('Erro ao carregar vídeo:', err)
        }
    }

    if (modal) {
        modal.addEventListener('show.bs.modal', async event => {
            const button = event.relatedTarget

            const modalTitle = modal.querySelector('#videoModalLabel') || modal.querySelector('.modal-title')
            if (modalTitle && button) {
                modalTitle.textContent = button.getAttribute('data-bs-title') || ''
            }

            if (!player) {
                player = videojs('player', {
                    controls: true,
                    preload: 'auto',
                    playbackRates: [0.5, 1, 1.25, 1.5, 2],
                    controlBar: {
                        skipButtons: {
                            forward: 10,
                            backward: 10
                        }
                    }
                })

                player.hlsQualitySelector({
                    displayCurrentQuality: true
                })
            }

            currentDubResolver = button.getAttribute('data-bs-video-resolver')
            currentLegResolver = button.getAttribute('data-bs-video-alternative-resolver')
            currentSourceUrl = null
            updateQualitySelector([])

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const langSwitcher = document.getElementById('videoLangSwitcher')
            const btnDub = document.getElementById('btnDub')
            const btnLeg = document.getElementById('btnLeg')

            if (btnDub) btnDub.classList.remove('active')
            if (btnLeg) btnLeg.classList.remove('active')

            if (hasDub && hasLeg) {
                if (langSwitcher) langSwitcher.style.display = 'flex'
                if (btnDub) {
                    btnDub.style.display = 'inline-block'
                    btnDub.classList.add('active')
                }
                if (btnLeg) {
                    btnLeg.style.display = 'inline-block'
                }
                currentLang = 'dub'
            } else {
                if (langSwitcher) langSwitcher.style.display = 'none'
                if (hasLeg) {
                    currentLang = 'leg'
                } else {
                    currentLang = 'dub'
                }
            }

            const initialResolver = (currentLang === 'leg' && hasLeg) ? currentLegResolver : currentDubResolver
            if (initialResolver && initialResolver.trim() !== '') {
                await resolveAndPlay(initialResolver, currentLang)
            }

            const subtitle = button.getAttribute('data-bs-video-subtitle')

            if (subtitle) {
                player.addRemoteTextTrack({
                    kind: 'captions',
                    src: subtitle,
                    srclang: 'pt',
                    label: 'Português'
                }, false)
            }
        })

        modal.addEventListener('hide.bs.modal', () => {
            if (player) {
                player.pause()
                player.reset()
            }
        })
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btnDub = document.getElementById('btnDub')
        const btnLeg = document.getElementById('btnLeg')

        async function switchLang(lang) {
            if (lang === currentLang) return

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const btnDubEl = document.getElementById('btnDub')
            const btnLegEl = document.getElementById('btnLeg')

            if (lang === 'dub' && hasDub) {
                btnDubEl?.classList.add('active')
                btnLegEl?.classList.remove('active')
                currentLang = 'dub'
                await resolveAndPlay(currentDubResolver, lang)
            } else if (lang === 'leg' && hasLeg) {
                btnLegEl?.classList.add('active')
                btnDubEl?.classList.remove('active')
                currentLang = 'leg'
                await resolveAndPlay(currentLegResolver, lang)
            }
        }

        btnDub?.addEventListener('click', () => switchLang('dub'))
        btnLeg?.addEventListener('click', () => switchLang('leg'))
    })
</script>
