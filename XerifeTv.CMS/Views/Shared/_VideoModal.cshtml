@inject IConfiguration Configuration

<div class="modal fade"
     id="videoModal"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     tabindex="-1"
     aria-labelledby="videoModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="videoModalLabel"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="height: 65vh; position: relative;">
                <video id="player"
                       class="video-js vjs-default-skin w-100"
                       style="min-height: 100%; max-height: 100%;"
                       controls>
                </video>
                <div id="videoLoadingOverlay"
                     style="display: none; position: absolute; inset: 0; z-index: 5;
                            align-items: center; justify-content: center; flex-direction: column;
                            gap: .75rem; background: rgba(0,0,0,.65); color: #fff; text-align: center;">
                    <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <div id="videoLoadingText" class="small">Carregando vídeo...</div>
                </div>
                <div id="videoErrorOverlay"
                     style="display: none; position: absolute; inset: 0; z-index: 5;
                            align-items: center; justify-content: center; flex-direction: column;
                            gap: .5rem; background: rgba(0,0,0,.75); color: #fff; text-align: center; padding: 1rem;">
                    <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
                    <div id="videoErrorText" class="small">Não foi possível carregar o vídeo.</div>
                </div>
            </div>
            <div class="modal-footer justify-content-center" id="videoLangSwitcher" style="display: none;">
                <div class="btn-group" role="group" aria-label="Seleção de idioma do vídeo">
                    <button type="button" class="btn btn-sm btn-outline-primary active" id="btnDub" data-lang="dub">
                        <i class="fa-solid fa-volume-high"></i> Dublado
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnLeg" data-lang="leg">
                        <i class="fa-solid fa-closed-captioning"></i> Legendado
                    </button>
                </div>
            </div>
            <div class="modal-footer justify-content-center" id="videoQualitySwitcher" style="display: none;">
                <label for="videoQualitySelect" class="form-label mb-0">Qualidade</label>
                <select class="form-select form-select-sm w-auto" id="videoQualitySelect" aria-label="Qualidade do vídeo"></select>
            </div>
        </div>
    </div>
</div>

<script defer>
    const modal = document.getElementById('videoModal')
    let player = undefined
    let currentDubResolver = null
    let currentLegResolver = null
    let currentLang = 'dub'
    let currentSources = []
    let currentSourceUrl = null
    // URL do Worker (cache KV compartilhado). Vazio = pula o Worker e vai direto no froststream.
    const streamCatalogProxyBaseUrl = '@((Configuration["StreamCatalog:ProxyBaseUrl"] ?? string.Empty).TrimEnd('/'))'

    function setLoading(visible, text) {
        const overlay = document.getElementById('videoLoadingOverlay')
        if (!overlay) return
        if (visible) hideError()
        const label = document.getElementById('videoLoadingText')
        if (text && label) label.textContent = text
        overlay.style.display = visible ? 'flex' : 'none'
    }

    function hideError() {
        const overlay = document.getElementById('videoErrorOverlay')
        if (overlay) overlay.style.display = 'none'
    }

    function showError(text) {
        setLoading(false)
        const overlay = document.getElementById('videoErrorOverlay')
        if (!overlay) return
        const label = document.getElementById('videoErrorText')
        if (text && label) label.textContent = text
        overlay.style.display = 'flex'
    }

    function getSources(data) {
        const sources = data.sources || data.Sources || data.streams || []
        return Array.isArray(sources) ? sources : []
    }

    function extractSourceUrl(value) {
        if (typeof value !== 'string') return ''

        const normalized = value.trim()
            .replace(/\\\[/g, '[')
            .replace(/\\\]/g, ']')
            .replace(/\\_/g, '_')
        const markdownStart = normalized.indexOf('](')
        const url = normalized.startsWith('[') && markdownStart > 0
            ? normalized.slice(markdownStart + 2).replace(/\)$/, '')
            : normalized

        return url.trim().replace(/^<|>$/g, '')
    }

    function getStreamFormat(url) {
        const path = String(url || '').split('?')[0].split('#')[0]
        const extension = path.split('.').pop()?.toLowerCase()
        return extension || (url.includes('.m3u8') ? 'hls' : 'mp4')
    }

    function getQuality(...values) {
        const pattern = /(?<![a-z0-9])(4k|2160p|1440p|1080p|720p|576p|480p|360p)(?![a-z0-9])/i
        for (const value of values) {
            const match = pattern.exec(typeof value === 'string' ? value : '')
            if (!match) continue

            const raw = match[1].toLowerCase()
            return {
                key: raw,
                label: raw === '4k' ? '4K' : raw
            }
        }

        return { key: 'auto', label: 'Auto' }
    }

    function qualityRank(value) {
        if (value === '4k') return 2160
        const rank = Number.parseInt(value, 10)
        return Number.isFinite(rank) ? rank : 0
    }

    function normalizeSources(data) {
        const unique = new Map()

        getSources(data).forEach(source => {
            const url = extractSourceUrl(source.url || source.Url)
            if (!url) return

            const quality = getQuality(
                source.quality || source.Quality,
                source.name || source.Name,
                source.title || source.Title,
                url
            )

            if (unique.has(quality.key)) return

            unique.set(quality.key, {
                ...source,
                url,
                quality: quality.label,
                streamFormat: source.streamFormat || source.StreamFormat || getStreamFormat(url)
            })
        })

        return [...unique.entries()]
            .sort(([left], [right]) => qualityRank(right) - qualityRank(left))
            .map(([, source]) => source)
    }

    function updateQualitySelector(sources) {
        const switcher = document.getElementById('videoQualitySwitcher')
        const select = document.getElementById('videoQualitySelect')
        if (!switcher || !select) return

        select.innerHTML = ''
        currentSources = sources

        sources.forEach(source => {
            const quality = source.quality || source.Quality || 'Auto'
            const url = extractSourceUrl(source.url || source.Url)
            if (!url) return

            const option = document.createElement('option')
            option.value = url
            option.textContent = quality
            select.appendChild(option)
        })

        switcher.style.display = sources.length > 1 ? 'flex' : 'none'
        select.value = currentSourceUrl || (sources[0]?.url || sources[0]?.Url || '')
        select.onchange = async () => {
            const selectedSource = currentSources.find(source => (source.url || source.Url) === select.value)
            if (selectedSource) await playSource(selectedSource)
        }
    }

    const resolvedSourceCache = new Map()

    async function getPlayableSource(source) {
        const sourceUrl = extractSourceUrl(source.url || source.Url)
        if (!sourceUrl) return null
        if (resolvedSourceCache.has(sourceUrl)) return resolvedSourceCache.get(sourceUrl)

        const streamFormat = (source.streamFormat || source.StreamFormat || getStreamFormat(sourceUrl)).toLowerCase()
        const params = new URLSearchParams({
            urlFixed: sourceUrl,
            streamFormat: streamFormat || 'mp4',
            followRedirect: 'false'
        })

        const promise = fetch('/MediaDeliveryProfiles/ResolveUrlFixed?' + params.toString(), {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
        })
            .then(response => {
                if (!response.ok) throw new Error('Erro ao gerar o proxy da fonte')
                return response.json()
            })
            .then(data => ({
                ...source,
                url: data.url || data.Url || sourceUrl,
                streamFormat: data.streamFormat || data.StreamFormat || streamFormat
            }))

        resolvedSourceCache.set(sourceUrl, promise)
        return promise
    }

    async function playSource(source) {
        const sourceUrl = extractSourceUrl(source.url || source.Url)
        if (!sourceUrl) return

        const playableSource = await getPlayableSource(source)
        if (!playableSource) return

        const url = playableSource.url
        const streamFormat = (playableSource.streamFormat || playableSource.StreamFormat || '').toLowerCase()

        currentSourceUrl = sourceUrl
        const playlistMimeTypes = {
            hls: 'application/x-mpegURL',
            m3u8: 'application/x-mpegURL'
        }

        const playlistType = playlistMimeTypes[streamFormat]
        player.src(playlistType ? { src: url, type: playlistType } : { src: url })
    }

    function isCatalogUrl(value) {
        if (!value) return false
        const normalized = String(value).toLowerCase()
        return normalized.includes('/stream/') || normalized.endsWith('.json')
    }

    // O froststream bloqueia o IP de datacenter do Render/Worker de forma intermitente,
    // mas o navegador do admin (IP residencial) sempre passa e o froststream libera CORS.
    // Então buscamos o catálogo aqui no browser e mandamos o JSON pro servidor só montar
    // as fontes - sem o servidor precisar falar com o froststream. Se qualquer passo
    // falhar, retorna null e o fluxo cai no resolver do servidor (comportamento antigo).
    async function resolveCatalogViaBrowser(resolverUrl) {
        let parsed
        try {
            parsed = new URL(resolverUrl, window.location.origin)
        } catch {
            return null
        }

        if (!parsed.pathname.endsWith('/ResolveUrlFixed')) return null

        const urlFixed = parsed.searchParams.get('urlFixed')
        if (!isCatalogUrl(urlFixed)) return null

        const streamFormat = parsed.searchParams.get('streamFormat') || 'mp4'
        const followRedirect = (parsed.searchParams.get('followRedirect') || 'false').toLowerCase() === 'true'

        let payload = null

        // 1) Worker primeiro: se o catálogo já está no KV, pega de lá (zero froststream)
        if (streamCatalogProxyBaseUrl) {
            try {
                const kvResponse = await fetch(
                    `${streamCatalogProxyBaseUrl}/?kvOnly=1&url=${encodeURIComponent(urlFixed)}`,
                    { headers: { Accept: 'application/json' } })
                if (kvResponse.ok) payload = await kvResponse.text()
            } catch { /* miss/erro: cai no browser abaixo */ }
        }

        // 2) Miss: navegador busca direto no froststream e grava no Worker pra próxima vez
        if (!payload) {
            const catalogResponse = await fetch(urlFixed, { headers: { Accept: 'application/json' } })
            if (!catalogResponse.ok) throw new Error('Falha ao buscar catálogo direto do froststream')
            payload = await catalogResponse.text()

            if (streamCatalogProxyBaseUrl) {
                // fire-and-forget: não trava a reprodução esperando a gravação
                fetch(`${streamCatalogProxyBaseUrl}/?url=${encodeURIComponent(urlFixed)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload
                }).catch(() => {})
            }
        }

        // 3) Servidor monta as fontes (probe + proxy) a partir do catálogo
        const response = await fetch('/MediaDeliveryProfiles/ResolveCatalogFromPayload', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ urlFixed, streamFormat, followRedirect, payload })
        })
        if (!response.ok) throw new Error('Falha ao resolver catálogo por payload')
        return await response.json()
    }

    async function resolveAndPlay(resolverUrl) {
        setLoading(true, 'Carregando vídeo...')
        try {
            let data = null

            try {
                data = await resolveCatalogViaBrowser(resolverUrl)
            } catch (browserErr) {
                console.warn('Resolução via navegador falhou, usando servidor:', browserErr)
                data = null
            }

            if (!data) {
                const response = await fetch(resolverUrl)
                if (!response.ok) throw new Error('Erro ao resolver URL')
                data = await response.json()
            }

            const url = data.url || data.Url
            const streamFormat = data.streamFormat || data.StreamFormat
            const sources = normalizeSources(data)

            if (sources.length > 0) {
                updateQualitySelector(sources)
                await playSource(sources[0])
                setLoading(false)
                return
            }

            updateQualitySelector([])
            await playSource({ url: extractSourceUrl(url), streamFormat })
            setLoading(false)
        }
        catch (err) {
            console.error('Erro ao carregar vídeo:', err)
            showError('Não foi possível carregar o vídeo. Tente novamente.')
        }
    }

    if (modal) {
        modal.addEventListener('show.bs.modal', async event => {
            const button = event.relatedTarget

            const modalTitle = modal.querySelector('#videoModalLabel') || modal.querySelector('.modal-title')
            if (modalTitle && button) {
                modalTitle.textContent = button.getAttribute('data-bs-title') || ''
            }

            if (!player) {
                player = videojs('player', {
                    controls: true,
                    preload: 'auto',
                    playbackRates: [0.5, 1, 1.25, 1.5, 2],
                    controlBar: {
                        skipButtons: {
                            forward: 10,
                            backward: 10
                        }
                    }
                })

                player.hlsQualitySelector({
                    displayCurrentQuality: true
                })
            }

            currentDubResolver = button.getAttribute('data-bs-video-resolver')
            currentLegResolver = button.getAttribute('data-bs-video-alternative-resolver')
            currentSourceUrl = null
            updateQualitySelector([])

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const langSwitcher = document.getElementById('videoLangSwitcher')
            const btnDub = document.getElementById('btnDub')
            const btnLeg = document.getElementById('btnLeg')

            if (btnDub) btnDub.classList.remove('active')
            if (btnLeg) btnLeg.classList.remove('active')

            if (hasDub && hasLeg) {
                if (langSwitcher) langSwitcher.style.display = 'flex'
                if (btnDub) {
                    btnDub.style.display = 'inline-block'
                    btnDub.classList.add('active')
                }
                if (btnLeg) {
                    btnLeg.style.display = 'inline-block'
                }
                currentLang = 'dub'
            } else {
                if (langSwitcher) langSwitcher.style.display = 'none'
                if (hasLeg) {
                    currentLang = 'leg'
                } else {
                    currentLang = 'dub'
                }
            }

            const initialResolver = (currentLang === 'leg' && hasLeg) ? currentLegResolver : currentDubResolver
            if (initialResolver && initialResolver.trim() !== '') {
                await resolveAndPlay(initialResolver, currentLang)
            }

            const subtitle = button.getAttribute('data-bs-video-subtitle')

            if (subtitle) {
                player.addRemoteTextTrack({
                    kind: 'captions',
                    src: subtitle,
                    srclang: 'pt',
                    label: 'Português'
                }, false)
            }
        })

        modal.addEventListener('hide.bs.modal', () => {
            setLoading(false)
            hideError()
            if (player) {
                player.pause()
                player.reset()
            }
        })
    }

    document.addEventListener('DOMContentLoaded', () => {
        const btnDub = document.getElementById('btnDub')
        const btnLeg = document.getElementById('btnLeg')

        async function switchLang(lang) {
            if (lang === currentLang) return

            const hasDub = currentDubResolver && currentDubResolver.trim() !== ''
            const hasLeg = currentLegResolver && currentLegResolver.trim() !== ''

            const btnDubEl = document.getElementById('btnDub')
            const btnLegEl = document.getElementById('btnLeg')

            if (lang === 'dub' && hasDub) {
                btnDubEl?.classList.add('active')
                btnLegEl?.classList.remove('active')
                currentLang = 'dub'
                await resolveAndPlay(currentDubResolver, lang)
            } else if (lang === 'leg' && hasLeg) {
                btnLegEl?.classList.add('active')
                btnDubEl?.classList.remove('active')
                currentLang = 'leg'
                await resolveAndPlay(currentLegResolver, lang)
            }
        }

        btnDub?.addEventListener('click', () => switchLang('dub'))
        btnLeg?.addEventListener('click', () => switchLang('leg'))
    })
</script>
